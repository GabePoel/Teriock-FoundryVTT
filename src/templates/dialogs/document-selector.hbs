<div class="dialog-form standard-form teriock dynamic-select document-selector-body">
  {{#if (exists hint)}}
    <p class="hint">
      {{{ hint }}}
    </p>
  {{/if}}

  <div class="teriock-block-searchbar">
    <label>
      <input class="search-input" type="search" placeholder="Search..." autocomplete="off" />
    </label>
    {{#if multi}}
      <button class="icon" type="button" aria-label="{{localize "TERIOCK.COMMON.All"}}" data-action="selectAll" data-tooltip="TERIOCK.COMMON.All">{{makeIcon TERIOCK.DISPLAY.icons.manifest.ui.selectAll "button"}}</button>
      <button class="icon" type="button" aria-label="{{localize "TERIOCK.COMMON.None"}}" data-action="selectNone" data-tooltip="TERIOCK.COMMON.None">{{makeIcon TERIOCK.DISPLAY.icons.manifest.ui.selectNone "button"}}</button>
    {{/if}}
  </div>

  {{#if (exists documents)}}
    <div class="doc-list-container scrollable scroll-fade" tabindex="0">
      {{> "teriock/shared/document-select-list"}}
    </div>
  {{/if}}

  {{#if content}}
    <div class="dialog-content">{{{content}}}</div>
  {{/if}}
</div>
