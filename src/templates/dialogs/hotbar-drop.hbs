<div class="teriock" style="display: flex; flex-direction: column; gap: 14px">
  <div class="form-group">
    <label>{{localize "TERIOCK.HOTBAR.UseDocument"}}</label>
    <p class="hint">
      {{localize
        "TERIOCK.HOTBAR.UseDocumentHint"
        child=child
      }}
    </p>
  </div>
  <div class="form-group">
    <label>{{localize "TERIOCK.HOTBAR.UseMatches"}}</label>
    <p class="hint">
      {{localize
        "TERIOCK.HOTBAR.UseMatchesHint"
        identifier=identifier
        label=label
        name=name
      }}
    </p>
  </div>
  <div class="form-group">
    <label>{{localize "HOTBAR.ToggleSheet" document=(localize "DOCUMENT.Document")}}</label>
    <p class="hint">
      {{localize
        "TERIOCK.HOTBAR.ToggleSheetHint"
        child=child
      }}
    </p>
  </div>
</div>
