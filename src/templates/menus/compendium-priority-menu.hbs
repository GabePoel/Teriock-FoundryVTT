<div class="teriock-compendium-priority-settings teriock-form-container">
  <p class="hint">{{localize "TERIOCK.SETTINGS.identifierSourcePriority.hint"}}</p>
  <div class="form-fields">
    <ul class="identifier-source-priority-list" data-sort-container>
      {{#each identifierSourcePriority}}
        <li
          class="identifier-source-priority-row draggable"
          data-identifier-priority-row
          data-identifier-priority-label="{{ label }}"
          data-identifier-priority-collection="{{ collection }}"
        >
          <span class="identifier-source-priority-number" data-identifier-priority-number>{{ priority }}</span>
          <div class="identifier-source-priority-controls">
            {{!-- prettier-ignore --}}
            <button
              id="{{ @root.partId }}-identifier-priority-up-{{ collection }}"
              class="identifier-source-priority-button"
              type="button"
              data-action="moveIdentifierPriority"
              data-identifier-priority-move="up"
              {{#if @first}}disabled{{/if}}
            >
              {{makeIcon "ms-arrow-drop-up" "solid"}}
            </button>
            {{!-- prettier-ignore --}}
            <button
              id="{{ @root.partId }}-identifier-priority-down-{{ collection }}"
              class="identifier-source-priority-button"
              type="button"
              data-action="moveIdentifierPriority"
              data-identifier-priority-move="down"
              {{#if @last}}disabled{{/if}}
            >
              {{makeIcon "ms-arrow-drop-down" "solid"}}
            </button>
          </div>
          <span class="identifier-source-priority-label">
            <i class="{{ icon }}"></i>
            {{ label }}
            <span class="hint">({{ collection }})</span>
          </span>
        </li>
      {{/each}}
    </ul>
  </div>
</div>
