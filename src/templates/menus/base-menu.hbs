{{!-- Blatantly stolen from D&D 5E and modified --}}
{{#if fieldset}}
  <fieldset
    {{disabled disabled}}
  >
    <legend>
      {{#if icon}}
        {{makeIcon icon}}
      {{/if}}
      {{ifThen label (localize label) (localize "SETUP.Configuration")}}
    </legend>
    {{> "teriock/shared/field-list"
      fields
    }}
  </fieldset>
{{else}}
  <div class="teriock-form-container">
    {{> "teriock/shared/field-list"
      fields
    }}
  </div>
{{/if}}
