<div class="teriock-sheet-bar">
  {{formUpdater
    document
    icon=TERIOCK.DISPLAY.icons.manifest.document.creature
    path="system.creatureType"
    placeholder=(localize "TERIOCK.SYSTEMS.Familiar.FIELDS.creatureType.label")
  }}
  {{formUpdater
    document
    data=familiarName
    icon=TERIOCK.DISPLAY.icons.manifest.familiar.actor
    path="system.actorUuid"
  }}
</div>
