{{#if system.lifespan.enabled}}
  <div class="teriock-sheet-bar">
    {{formUpdater
      document
      data=(localize "TERIOCK.SYSTEMS.Species.PANELS.lifespan.adulthood" value=system.lifespan.adulthood)
      icon=TERIOCK.display.icons.manifest.species.adulthood
      path="system.lifespan.adulthood"
      paths="system.lifespan.adulthood system.lifespan.max"
      source=(localize "TERIOCK.SYSTEMS.Species.PANELS.lifespan.adulthood" value=system._source.lifespan.adulthood)
      dataset=(object
        title="TERIOCK.SYSTEMS.Species.FIELDS.lifespan.enabled.label"
        icon=TERIOCK.display.icons.manifest.species.adulthood)
    }}
    {{formUpdater
      document
      data=(localize "TERIOCK.SYSTEMS.Species.PANELS.lifespan.max" value=(asInf system.lifespan.max))
      icon=TERIOCK.display.icons.manifest.species.lifespan
      path="system.lifespan.max"
      paths="system.lifespan.adulthood system.lifespan.max"
      source=(localize "TERIOCK.SYSTEMS.Species.PANELS.lifespan.max" value=(asInf system._source.lifespan.max))
      dataset=(object
        title="TERIOCK.SYSTEMS.Species.FIELDS.lifespan.enabled.label"
        icon=TERIOCK.display.icons.manifest.species.adulthood)
    }}
  </div>
{{/if}}
