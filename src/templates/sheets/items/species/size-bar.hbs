{{#if system.size.enabled}}
  <div class="teriock-sheet-bar">
    {{formUpdater
      document
      data=(localize "TERIOCK.SYSTEMS.Species.PANELS.size.value" value=system.size.value)
      icon=TERIOCK.DISPLAY.icons.manifest.species.size
      info="core:size"
      path="system.size.value"
      paths="system.size.value system.size.min system.size.max"
      source=(localize "TERIOCK.SYSTEMS.Species.PANELS.size.value" value=system._source.size.value)
      dataset=(object title="TERIOCK.COMMON.Size" icon=TERIOCK.DISPLAY.icons.manifest.species.size)
    }}
    {{#if (exists system.size.min)}}
      {{formUpdater
        document
        data=(localize "TERIOCK.SYSTEMS.Species.PANELS.size.min" value=system.size.min)
        icon=TERIOCK.DISPLAY.icons.manifest.species.minSize
        info="core:size"
        path="system.size.min"
        paths="system.size.value system.size.min system.size.max"
        source=(localize "TERIOCK.SYSTEMS.Species.PANELS.size.min" value=system._source.size.min)
        dataset=(object title="TERIOCK.COMMON.Size" icon=TERIOCK.DISPLAY.icons.manifest.species.size)
      }}
    {{/if}}
    {{#if (exists system.size.max)}}
      {{formUpdater
        document
        data=(localize "TERIOCK.SYSTEMS.Species.PANELS.size.max" value=system.size.max)
        icon=TERIOCK.DISPLAY.icons.manifest.species.maxSize
        info="core:size"
        path="system.size.max"
        paths="system.size.value system.size.min system.size.max"
        source=(localize "TERIOCK.SYSTEMS.Species.PANELS.size.max" value=system._source.size.max)
        dataset=(object title="TERIOCK.COMMON.Size" icon=TERIOCK.DISPLAY.icons.manifest.species.size)
      }}
    {{/if}}
  </div>
{{/if}}
