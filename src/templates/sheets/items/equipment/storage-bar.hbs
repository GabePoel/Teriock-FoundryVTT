{{#if system.storage.enabled}}
  <div class="teriock-sheet-bar">
    {{formUpdater
      document
      abbreviation="ITEMS"
      color=(ifThen system.storage.isOverCountCapacity TERIOCK.display.colors.palette.red null)
      data=(ifThen
        (isFinite system.storage.maxCount)
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.carriedCount denominator=system.storage.maxCount)
        system.storage.carriedCount)
      icon=TERIOCK.display.icons.manifest.equipment.maxCount
      label=(localize
        (concat "TERIOCK.MODELS.Storage.FIELDS.maxCount." (ifThen system.storage.isOverCountCapacity "over" "under")))
      path="system.storage.maxCount"
      placeholder=(makeIcon TERIOCK.display.icons.manifest.ui.infinity)
      source=(ifThen
        (eq system.storage._source.maxCount null)
        system.storage.carriedCount
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.carriedCount denominator=system.storage._source.maxCount))
    }}
    {{formUpdater
      document
      abbreviation="lb"
      color=(ifThen system.storage.isOverWeightCapacity TERIOCK.display.colors.palette.red null)
      data=(ifThen
        (isFinite system.storage.maxWeight)
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.carriedWeight denominator=system.storage.maxWeight)
        system.storage.carriedWeight)
      icon=TERIOCK.display.icons.manifest.equipment.maxWeight
      label=(localize
        (concat "TERIOCK.MODELS.Storage.FIELDS.maxWeight." (ifThen system.storage.isOverWeightCapacity "over" "under")))
      path="system.storage.maxWeight"
      placeholder=(makeIcon TERIOCK.display.icons.manifest.ui.infinity)
      source=(ifThen
        (eq system.storage._source.maxWeight null)
        system.storage.carriedWeight
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.carriedWeight denominator=system.storage._source.maxWeight))
    }}
    {{formUpdater
      document
      icon=TERIOCK.display.icons.manifest.equipment.weightMultiplier
      path="system.storage.weightMultiplier"
      placeholder="1"
    }}
  </div>
{{/if}}
