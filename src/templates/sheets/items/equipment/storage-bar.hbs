{{#if system.storage.enabled}}
  <div class="teriock-sheet-bar">
    {{formUpdater
      document
      abbreviation="ITEMS"
      color=(ifThen system.storage.count.over TERIOCK.DISPLAY.colors.palette.red null)
      data=(ifThen
        (isFinite system.storage.count.max)
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.count.value denominator=system.storage.count.max)
        system.storage.count.value)
      icon=TERIOCK.DISPLAY.icons.manifest.equipment.maxCount
      label=(localize
        (concat "TERIOCK.SYSTEMS.Equipment.FIELDS.storage.count.max." (ifThen system.storage.count.over "over" "under")))
      path="system.storage.count.max"
      placeholder=(makeIcon TERIOCK.DISPLAY.icons.manifest.ui.infinity)
      source=(ifThen
        (eq system._source.storage.count.max null)
        system.storage.count.value
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.count.value denominator=system._source.storage.count.max))
    }}
    {{formUpdater
      document
      abbreviation="lb"
      color=(ifThen system.storage.weight.over TERIOCK.DISPLAY.colors.palette.red null)
      data=(ifThen
        (isFinite system.storage.weight.max)
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.weight.value denominator=system.storage.weight.max)
        system.storage.weight.value)
      icon=TERIOCK.DISPLAY.icons.manifest.equipment.maxWeight
      label=(localize
        (concat "TERIOCK.SYSTEMS.Equipment.FIELDS.storage.weight.max." (ifThen system.storage.weight.over "over" "under")))
      path="system.storage.weight.max"
      placeholder=(makeIcon TERIOCK.DISPLAY.icons.manifest.ui.infinity)
      source=(ifThen
        (eq system._source.storage.weight.max null)
        system.storage.weight.value
        (localize "TERIOCK.FORMAT.outOf" numerator=system.storage.weight.value denominator=system._source.storage.weight.max))
    }}
    {{formUpdater
      document
      icon=TERIOCK.DISPLAY.icons.manifest.equipment.weightMultiplier
      path="system.storage.weight.multiplier"
      placeholder="1"
    }}
  </div>
{{/if}}
