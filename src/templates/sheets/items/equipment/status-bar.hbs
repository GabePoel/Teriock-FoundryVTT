<div class="teriock-sheet-bar">
  {{#if (and isGM (not system.identification.read))}}
    {{> "teriock/sheets/shared/forms/kind-form"
      kindValue=system.identification.kind
      kindIcon="unknown"
    }}
  {{else}}
    {{> "teriock/sheets/shared/forms/kind-form"
      kindValue=system.kind
    }}
  {{/if}}
  {{formBox
    system._source.equipmentType
    action=(ifThen editable "updatePaths" "")
    dataset=(object paths="system.equipmentType")
    icon=TERIOCK.display.icons.manifest.equipment.equipmentType
    placeholder=(localize "TERIOCK.SYSTEMS.Equipment.FIELDS.equipmentType.label")
    tooltip=(localize "TERIOCK.SYSTEMS.Equipment.FIELDS.equipmentType.label")
    unselected=(getName system.equipmentType)
  }}
  {{formBox
    rangeString
    action=(ifThen editable "editArmamentRange" "")
    icon=TERIOCK.display.icons.manifest.ability.range
    label=(ifThen (eq system.range.long.unitType "finite") (localize system.range.long.symbol) "")
    overflow=true
    tooltip=(localize "TERIOCK.SYSTEMS.Armament.FIELDS.range.long.raw.label")
    unselected=sourceRangeString
  }}
</div>
