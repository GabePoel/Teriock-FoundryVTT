<div class="teriock-sheet-bar">
  {{> "teriock/sheets/shared/forms/kind-form"
    kindValue=(ifThen (and isGM (not system.identification.read)) system._source.kind system.kind)
    unknown=(not (or isGM system.identification.read))
  }}
  {{formUpdater
    document
    icon=TERIOCK.DISPLAY.icons.manifest.equipment.equipmentType
    path="system.equipmentType"
    placeholder=(localize "TERIOCK.SYSTEMS.Equipment.FIELDS.equipmentType.label")
  }}
  {{formUpdater
    document
    abbreviation=(ifThen (eq system.range.long.unitType "finite") (localize system.range.long.symbol) "")
    abbreviationTooltip=(ifThen (eq system.range.long.unitType "finite") system.range.long.unitLabel "")
    action="openUpdater"
    data=range.data
    dataset=(object updater="ArmamentRangeUpdater")
    icon=TERIOCK.DISPLAY.icons.manifest.ability.range
    info="core:range"
    label=(localize "TERIOCK.SYSTEMS.Armament.FIELDS.range.long.raw.label")
    source=range.source
  }}
</div>
