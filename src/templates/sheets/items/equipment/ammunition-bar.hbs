{{#if system.ammunition.enabled}}
  <div class="teriock-sheet-bar">
    {{formUpdater
      document
      icon=TERIOCK.DISPLAY.icons.manifest.equipment.ammunition
      path="system.ammunition.type"
      placeholder=(localize "TERIOCK.SYSTEMS.Equipment.FIELDS.ammunition.type.label")
    }}
    {{formUpdater
      document
      data=(localize "TERIOCK.SYSTEMS.Consumable.EMBED.perUse" value=system.ammunition.amount)
      icon=TERIOCK.DISPLAY.icons.manifest.ui.amount
      path="system.ammunition.amount"
      placeholder="0"
      source=(localize "TERIOCK.SYSTEMS.Consumable.EMBED.perUse" value=system._source.ammunition.amount)
    }}
  </div>
{{/if}}
