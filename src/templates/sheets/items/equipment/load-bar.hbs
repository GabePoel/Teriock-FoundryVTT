<div class="teriock-sheet-bar">
  {{> "teriock/sheets/shared/forms/tier-form"
    unknown=system.isTierSecret
  }}
  {{> "teriock/sheets/shared/forms/price-form"
    pricePath=(ifThen (and isGM (not system.identification.identified)) "system.identification.price" "system.price")
    unknown=system.isSecret
  }}
  {{formUpdater
    document
    icon=TERIOCK.DISPLAY.icons.manifest.equipment.weight
    label=(localize "TERIOCK.SYSTEMS.Equipment.FIELDS.weight.label")
    path="system.weight"
  }}
  {{formUpdater
    document
    abbreviation=(localize "TERIOCK.TERMS.Attributes.str.abbreviation")
    icon=TERIOCK.DISPLAY.icons.manifest.equipment.minStr
    info="core:strength"
    path="system.minStr"
  }}
</div>
