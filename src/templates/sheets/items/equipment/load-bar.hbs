<div class="teriock-sheet-bar">
  {{#if (or system.identification.identified system.isAttuned)}}
    {{> "teriock/sheets/shared/forms/attunable-forms"}}
  {{/if}}
  {{formUpdater
    document
    icon=TERIOCK.DISPLAY.icons.manifest.equipment.weight
    label=(localize "TERIOCK.SYSTEMS.Equipment.FIELDS.weight.label")
    path="system.weight"
  }}
  {{formUpdater
    document
    abbreviation=(localize "TERIOCK.TERMS.Attributes.str.abbreviation")
    icon=TERIOCK.DISPLAY.icons.manifest.equipment.minStr
    info="core:strength"
    path="system.minStr"
  }}
</div>
