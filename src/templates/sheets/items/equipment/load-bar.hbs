<div class="teriock-sheet-bar">
  {{#if (or system.identification.identified system.isAttuned)}}
    {{> "teriock/sheets/shared/forms/attunable-forms"}}
  {{/if}}
  {{formUpdater
    document
    abbreviation=(ifThen (eq system.weight.unitType "finite") (localize system.weight.symbol) "")
    abbreviationTooltip=(ifThen (eq system.weight.unitType "finite") system.weight.unitName "")
    action="updateUnit"
    data=weight.data
    dataset=(object path="system.weight")
    icon=TERIOCK.DISPLAY.icons.manifest.equipment.weight
    label=(localize "TERIOCK.SYSTEMS.Equipment.FIELDS.weight.label")
    locked=weight.locked
    path="system.weight"
    source=weight.source
  }}
  {{formUpdater
    document
    abbreviation=(localize "TERIOCK.TERMS.Attributes.str.abbreviation")
    icon=TERIOCK.DISPLAY.icons.manifest.equipment.minStr
    info="core:strength"
    path="system.minStr"
  }}
</div>
