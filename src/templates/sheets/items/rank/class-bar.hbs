<div class="teriock-sheet-bar">
  {{> "teriock/sheets/shared/forms/kind-form"
    kindUpdater="RankKindUpdater"
    kindValue=system.kind
  }}
  {{formUpdater
    document
    action="openUpdater"
    dataset=(object updater="RankClassUpdater")
    icon=(path TERIOCK.CONFIG.class.archetypes system.archetype "icon")
    info=(concat "archetype:" system.archetype)
    label="TERIOCK.SYSTEMS.Rank.FIELDS.archetype.label"
    path="system.archetype"
  }}
  {{formUpdater
    document
    action="openUpdater"
    dataset=(object updater="RankClassUpdater")
    icon=system.classIcon
    info=(concat "class:" system.class)
    label="TERIOCK.SYSTEMS.Rank.FIELDS.class.label"
    path="system.class"
  }}
  {{formUpdater
    document
    data=(localize "TERIOCK.SYSTEMS.Rank.PANELS.rank" value=system.number)
    icon=system.metadata.icon
    label="TERIOCK.SYSTEMS.Rank.FIELDS.number.label"
    path="system.number"
    source=(localize "TERIOCK.SYSTEMS.Rank.PANELS.rank" value=system._source.number)
  }}
</div>
