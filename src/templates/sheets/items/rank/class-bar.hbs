<div class="teriock-sheet-bar">
  {{> "teriock/sheets/shared/forms/kind-form"
    kindValue=system.kind
  }}
  {{formUpdater
    document
    action="updateClass"
    data=(getName system.archetype)
    icon=(path TERIOCK.CONFIG.class.archetypes system._source.archetype "icon")
    info=system.archetype
    label=(localize "TERIOCK.SYSTEMS.Rank.FIELDS.archetype.label")
    path="system.archetype"
    source=system._source.archetype
  }}
  {{formUpdater
    document
    action="updateClass"
    data=(getName system.class)
    icon=system.classIcon
    info=system.class
    label=(localize "TERIOCK.SYSTEMS.Rank.FIELDS.class.label")
    path="system.class"
    source=system._source.class
  }}
  {{formUpdater
    document
    data=(localize "TERIOCK.SYSTEMS.Rank.PANELS.rank" value=system.number)
    icon=system.metadata.icon
    label=(localize "TERIOCK.SYSTEMS.Rank.FIELDS.number.label")
    path="system.number"
    source=(localize "TERIOCK.SYSTEMS.Rank.PANELS.rank" value=system._source.number)
  }}
</div>
