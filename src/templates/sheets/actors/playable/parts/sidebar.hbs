<div class="actor-sidebar sidebar-collapser collapsible theme-dark" data-collapsible-id="sidebar">
  <div class="actor-sidebar-container">
    <div class="actor-intro-box">
      <div
        class="
          actor-avatar
          timage
          {{#if displayedImgRing}}
            ring
          {{/if}}
        "
        data-src="{{ img }}"
      >
        <div class="actor-avatar-shadow">
          <div class="actor-avatar-buttons">
            {{#if (eq displayedImgDocument "token")}}
              <button
                id="{{ @root/appId }}-avatar-ring"
                class="tbutton thover"
                type="button"
                {{#if displayedImgRing}}
                  data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Avatar.ringEnabled"}}'
                {{else}}
                  data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Avatar.ringDisabled"}}'
                {{/if}}
                data-action="toggleRing"
              >
                {{makeIcon (lookup TERIOCK.DISPLAY.icons.manifest.ui (ifThen displayedImgRing "enabled" "disabled")) "light"}}
              </button>
            {{/if}}
            <button id="{{ @root/appId }}-avatar-switch" class="tbutton thover" type="button" data-disable="false" data-tooltip="{{ displayedImgTooltip }}" data-action="switchImage">{{makeIcon displayedImgIcon "light"}}</button>
          </div>
        </div>
        <img
          class="actor-avatar-img"
          src="{{ displayedImg }}"
          data-edit="{{ editableImgPath }}"
          data-action="editImage"
          data-disable="false"
          alt="{{ name }}"
        />
        <div class="actor-avatar-background">
          {{#if displayedImgRing}}
            <div class="actor-avatar-token-circle inner"></div>
            <div class="actor-avatar-token-circle outer"></div>
          {{/if}}
        </div>
      </div>
      <div
        class="
          actor-name
          {{#if displayedImgRing}}
            ring
          {{/if}}
        "
        data-debug="true"
      >
        {{formInput
          fields.name
          value=name
          classes="actor-name-text"
        }}
      </div>
      <div class="actor-basics">
        <span class="actor-shortbox actor-level-box">
          <span class="actor-shortbox-value">
            <button
              id="{{ @root/appId }}-lvl"
              class='affix updatable {{formClasses @root/document path="system.scaling.lvl"}}'
              type="button"
              data-action="updatePaths"
              data-icon="{{ TERIOCK.DISPLAY.icons.manifest.ui.level }}"
              data-paths="system.scaling.lvl system.scaling.br system.scaling.brScale"
            >
              <span class="unselected">{{ system.scaling.lvl }}</span>
              <span class="selected">{{ system._source.scaling.lvl }}</span>
            </button>
          </span>
          <span class="actor-level-label actor-shortbox-label">
            {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.labels.lvl"}}
          </span>
        </span>
        {{#if system.scaling.brScale}}
          <span class="actor-shortbox actor-br-box">
            <span class="actor-shortbox-value">
              <button
                id="{{ @root/appId }}-br"
                class='affix updatable {{formClasses @root/document path="system.scaling.br"}}'
                type="button"
                data-action="updatePaths"
                data-icon="{{ TERIOCK.DISPLAY.icons.manifest.ui.level }}"
                data-paths="system.scaling.lvl system.scaling.br system.scaling.brScale"
              >
                <span class="unselected">{{ system.scaling.br }}</span>
                <span class="selected">
                  {{ifThen (eq system._source.scaling.br null) system.scaling.br system._source.scaling.br}}
                </span>
              </button>
            </span>
            <span class="actor-br-label actor-shortbox-label">
              {{localize "TERIOCK.SYSTEMS.BaseActor.FIELDS.scaling.br.abbreviation"}}
            </span>
          </span>
        {{/if}}
        <span
          class="actor-shortbox actor-rank-box"
          data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.tooltip.lvl"}}'
        >
          <span class="actor-shortbox-value">{{ system.scaling.rank }}</span>
          <span class="actor-class-label actor-shortbox-label">
            {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.labels.rank"}}
          </span>
        </span>
        <span
          class="actor-shortbox actor-proficiency-box"
          {{#if system.scaling.brScale}}
            data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.tooltip.br"}}'
          {{else}}
            data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.tooltip.lvl"}}'
          {{/if}}
        >
          <span class="actor-shortbox-value">{{ system.scaling.p }}</span>
          <span class="actor-level-label actor-shortbox-label">
            {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.labels.pro"}}
          </span>
        </span>
        <span
          class="actor-shortbox actor-fluency-box"
          {{#if system.scaling.brScale}}
            data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.tooltip.br"}}'
          {{else}}
            data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.tooltip.lvl"}}'
          {{/if}}
        >
          <span class="actor-shortbox-value">{{ system.scaling.f }}</span>
          <span class="actor-fluency-label actor-shortbox-label">
            {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Scaling.labels.flu"}}
          </span>
        </span>
      </div>
    </div>
    {{> "teriock/sheets/actors/playable/parts/status-box"}}
    {{> "teriock/sheets/actors/playable/parts/battle-box"}}
    {{> "teriock/sheets/actors/playable/parts/attribute-box"}}
    {{> "teriock/sheets/actors/playable/parts/initiative-box"}}
  </div>
</div>
