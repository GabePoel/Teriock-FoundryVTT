<div class="ch-battle-box tbox toutline">
  <div class="defense-box">
    <div class="actor-stats defense-box-main">
      <div class="actor-stat">
        <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.CoverBox.label"}}</div>
        <button
          id="{{ @root/appId }}-cover"
          class="actor-stat-value updatable"
          type="button"
          data-action="increaseCover"
          data-tooltip-class=""
          data-tooltip-direction="DOWN"
        >
          <i
            {{#if (eq system.cover 0)}}
              class='{{makeIconClass TERIOCK.display.icons.manifest.ui.off "solid"}}'
              data-tooltip='{{localize "TERIOCK.STATUSES.Cover.noCover"}}'
            {{/if}}
            {{#if (eq system.cover 1)}}
              class='{{makeIconClass TERIOCK.display.icons.manifest.cover.half "solid"}}'
              data-tooltip='{{localize "TERIOCK.STATUSES.Cover.halfCover"}}'
            {{/if}}
            {{#if (eq system.cover 2)}}
              class='{{makeIconClass TERIOCK.display.icons.manifest.cover.partial "solid"}}'
              data-tooltip='{{localize "TERIOCK.STATUSES.Cover.threeQuartersCover"}}'
            {{/if}}
            {{#if (eq system.cover 3)}}
              class='{{makeIconClass TERIOCK.display.icons.manifest.cover.full "solid"}}'
              data-tooltip='{{localize "TERIOCK.STATUSES.Cover.fullCover"}}'
            {{/if}}
          ></i>
        </button>
      </div>

      <div class="actor-stat">
        <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.ac.label"}}</div>
        <button
          id="{{ @root/appId }}-ac"
          class='actor-stat-value affix updatable {{formClasses @root/document path="system.defense.ac"}}'
          type="button"
          data-action="updatePaths"
          data-icon="{{ TERIOCK.display.icons.manifest.armament.av }}"
          data-paths="system.defense.ac"
          data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.ac.tooltip"}}'
        >
          <span class="unselected">{{ system.defense.ac }}</span>
          <span class="selected">
            {{ifThen (eq system._source.defense.ac null) system.defense.ac system._source.defense.ac}}
          </span>
        </button>
      </div>

      <div class="actor-stat">
        <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.bv.label"}}</div>
        <button
          id="{{ @root/appId }}-bv"
          class='actor-stat-value affix updatable {{formClasses @root/document path="system.defense.bv"}}'
          type="button"
          data-action="updatePaths"
          data-icon="{{ TERIOCK.display.icons.manifest.armament.bv }}"
          data-paths="system.defense.bv"
          data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.bv.tooltip"}}'
        >
          <span class="unselected">{{ system.defense.bv }}</span>
          <span class="selected">
            {{ifThen (eq system._source.defense.bv null) system.defense.bv system._source.defense.bv}}
          </span>
        </button>
      </div>

      <div class="actor-stat">
        <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.cc.label"}}</div>
        <div class="actor-stat-value" data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.cc.tooltip"}}'>
          {{{ system.defense.cc }}}
        </div>
      </div>
    </div>

    <div class="actor-primary-blocker teriock-full-width">
      <div class="tsubtle little-title">
        <div class="title-left">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.blockingWith"}}</div>
        <div class="title-right">
          {{#if (exists system.wielding.blocker)}}
            <button
              id="{{ @root/appId }}-block-roll"
              class="tbutton thover"
              type="button"
              data-action="useAbility"
              data-ability="ability:basic-block"
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.rollBlock"}}'
              data-disable="false"
            >
              <i class='{{makeIconClass TERIOCK.display.icons.manifest.interaction.block "light"}}'></i>
            </button>
            <button
              id="{{ @root/appId }}-block-interact"
              class="tbutton thover"
              type="button"
              data-action="quickUse"
              data-id="{{ system.wielding.blocker._id }}"
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.rollInteract"}}'
              data-deal-impacts="false"
              data-disable="false"
            >
              <i class='{{makeIconClass TERIOCK.display.icons.manifest.effect.interact "light"}}'></i>
            </button>
            <button
              id="{{ @root/appId }}-block-open"
              class="tbutton thover"
              type="button"
              data-action="openPrimaryBlocker"
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.open"}}'
              data-disable="false"
            >
              <i class='{{makeIconClass TERIOCK.display.icons.manifest.ui.openWindow "light"}}'></i>
            </button>
          {{/if}}
        </div>
      </div>
      <button
        id="{{ @root/appId }}-blocker"
        class="
          actor-primary-blocker-select
          updatable
          {{#if system.wielding.blocker.uuid}}
            draggable
          {{/if}}
        "
        type="button"
        data-disable="false"
        data-action="selectBlocker"
        data-tooltip-direction="LEFT"
        {{#if (exists system.wielding.blocker)}}
          data-tooltip-uuid="{{ system.wielding.blocker.uuid }}"
          data-uuid="{{ system.wielding.blocker.uuid }}"
        {{/if}}
      >
        {{#if (exists system.wielding.blocker)}}
          {{{ system.wielding.blocker.name }}}
        {{else}}
          {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.none"}}
        {{/if}}
      </button>
    </div>
  </div>

  {{#if inCombat}}
    <div class="defense-box">
      <div class="actor-stats">
        <div class="actor-stat">
          <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.ActionBox.label"}}</div>
          {{numberInput
            actions
            classes="actor-combatant-input actor-stat-value updatable"
            dataset=(object tooltip=(localize "TERIOCK.SHEETS.Actor.SIDEBAR.ActionBox.tooltip"))
            id=(concat @root/appId "-combatant-actions")
            name="system.actions"
            named=false
            min=0
            max=3
          }}
        </div>
        <div class="actor-stat">
          <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.ReactionBox.label"}}</div>
          <button
            id="{{ @root/appId }}-reaction"
            class="actor-stat-value updatable"
            type="button"
            data-action="toggleReaction"
            data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.ReactionBox.tooltip"}}'
          >
            <i class='{{makeIconClass (path TERIOCK.display.icons.manifest.ui (ifThen reactions "on" "off")) "light"}}'
            ></i>
          </button>
        </div>
        <div class="actor-stat">
          <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.penalty.label"}}</div>
          {{formInput
            combatantFields.attackPenalty
            value=attackPenalty
            classes="actor-combatant-input actor-stat-value updatable"
            dataset=(object
            action="resetAttackPenalty"
            tooltip=(localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.penalty.tooltip"))
            id=(concat @root/appId "-combatant-attackPenalty")
            name="system.attackPenalty"
            named=false
          }}
        </div>
      </div>
    </div>
  {{/if}}

  <div class="attack-box">
    <div class="actor-stats attack-box-main">
      <div class="actor-stat">
        <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.piercing.label"}}</div>
        <button
          id="{{ @root/appId }}-piercing"
          class="actor-stat-value updatable"
          type="button"
          data-action="updatePaths"
          data-icon="{{ TERIOCK.display.icons.manifest.piercing.ub }}"
          data-paths="system.offense.piercing.raw"
          data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.piercing.tooltip"}}'
        >
          {{#if (or
            system.offense.piercing.ub
            system.wielding.attacker.system.piercing.ub)
          }}
            {{#if system.offense.piercing.ub}}
              {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.ub.forced"}}
            {{else}}
              {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.ub.normal"}}
            {{/if}}
          {{else}}
            {{#if (or
              system.offense.piercing.av0
              system.wielding.attacker.system.piercing.av0)
            }}
              {{#if system.offense.piercing.av0}}
                {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.av0.forced"}}
              {{else}}
                {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.av0.normal"}}
              {{/if}}
            {{else}}
              <i class='{{makeIconClass TERIOCK.display.icons.manifest.ui.off "light"}}'></i>
            {{/if}}
          {{/if}}
        </button>
      </div>

      <div class="actor-stat">
        <div class="tsubtle">{{localize "TERIOCK.SYSTEMS.BaseActor.FIELDS.offense.sb.label"}}</div>
        <button
          id="{{ @root/appId }}-sb"
          class="actor-stat-value updatable"
          type="button"
          data-action="toggleSb"
          data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.sb.tooltip"}}'
        >
          <i
            class='{{makeIconClass (path TERIOCK.display.icons.manifest.ui (ifThen system.offense.sb "on" "off")) "light"}}'
          ></i>
        </button>
      </div>
    </div>

    <div class="actor-primary-attacker teriock-full-width">
      <div class="tsubtle little-title">
        <div class="title-left">{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.attackingWith"}}</div>
        <div class="title-right">
          <button
            id="{{ @root/appId }}-attack-roll"
            class="tbutton thover"
            type="button"
            data-action="useAbility"
            data-ability="ability:basic-attack"
            data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.rollAttack"}}'
            data-disable="false"
          >
            <i class='{{makeIconClass TERIOCK.display.icons.manifest.interaction.attack "light"}}'></i>
          </button>
          {{#if (exists system.wielding.attacker)}}
            <button
              id="{{ @root/appId }}-attack-damage"
              class="tbutton thover"
              type="button"
              data-action="quickUse"
              data-id="{{ system.wielding.attacker._id }}"
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.rollDamage"}}'
              data-deal-impacts="true"
              data-disable="false"
            >
              <i class='{{makeIconClass TERIOCK.display.icons.manifest.effect.dealDamage "light"}}'></i>
            </button>
            <button
              id="{{ @root/appId }}-attack-open"
              class="tbutton thover"
              type="button"
              data-action="openPrimaryAttacker"
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.open"}}'
              data-disable="false"
            >
              <i class='{{makeIconClass TERIOCK.display.icons.manifest.ui.openWindow "light"}}'></i>
            </button>
          {{/if}}
        </div>
      </div>

      <button
        id="{{ @root/appId }}-attacker"
        class="
          actor-primary-attacker-select
          updatable
          {{#if system.wielding.attacker.uuid}}
            draggable
          {{/if}}
        "
        type="button"
        data-disable="false"
        data-action="selectAttacker"
        data-tooltip-direction="LEFT"
        {{#if (exists system.wielding.attacker)}}
          data-tooltip-uuid="{{ system.wielding.attacker.uuid }}"
          data-uuid="{{ system.wielding.attacker.uuid }}"
        {{/if}}
      >
        {{#if (exists system.wielding.attacker)}}
          {{{ system.wielding.attacker.name }}}
        {{else}}
          {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.none"}}
        {{/if}}
      </button>

      {{#if (exists system.wielding.attacker.system.styleDescription)}}
        <div class="tsubtle little-title actor-fighting-style-label">
          {{getName system.wielding.attacker.system.style}}
          {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.BattleBox.fightingStyle"}}
        </div>
        <div class="actor-fighting-style-summary">
          {{{ enrichedStyleDescription }}}
        </div>
      {{/if}}
    </div>
  </div>
</div>
