<div
  class="
    actor-presence-container
    actor-bar-container
    {{#if system.presence.over}}
      overflow
    {{/if}}
  "
>
  <div
    class="actor-presence-bar actor-bar toutline"
    style="grid-template-columns: {{repeatStr system.presence.max ' 1fr'}}"
  >
    {{#if (gte system.presence.value 1)}}
      <div
        class="presence-indicator used"
        style="grid-column: span {{{ system.presence.value }}}; grid-template-columns: {{repeatStr system.presence.value ' 1fr'}}"
      >
        {{#repeat system.presence.value}}
          <div class="presence-indicator empty"></div>
        {{/repeat}}
      </div>
    {{/if}}
    {{#repeat system.attributes.unp.score}}
      <div class="presence-indicator unused"></div>
    {{/repeat}}
  </div>
  <div
    class="actor-bar-overlay-text"
    data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.Bars.presence.tooltip" value=system.presence.value max=system.presence.max}}'
  >
    {{ system.presence.value }}
    /
    {{ system.presence.max }}
  </div>
  <div class="actor-bar-actions">{{infoIcon "core:presence"}}</div>
</div>
