<div class="field-panel">
  <div class="tradecraft-panel tgrid" data-tooltip-direction="UP">
    <div
      class="tradecraft-panel-symbol field-panel-header"
      data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Tradecrafts.competence.tooltip"}}'
    >
      {{localize "TERIOCK.SHEETS.Actor.TABS.Tradecrafts.competence.label"}}
    </div>
    <div class="tradecraft-panel-name field-panel-header gi3">
      <span data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Tradecrafts.name.tooltip"}}'>{{ field.label }}</span>
    </div>
    <div
      class="tradecraft-panel-symbol field-panel-header"
      data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Tradecrafts.score.tooltip"}}'
    >
      {{localize "TERIOCK.SHEETS.Actor.TABS.Tradecrafts.score.label"}}
    </div>
    <div
      class="tradecraft-panel-symbol field-panel-header"
      data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Tradecrafts.modifier.tooltip"}}'
    >
      {{localize "TERIOCK.SHEETS.Actor.TABS.Tradecrafts.modifier.label"}}
    </div>
    {{#each field.tradecrafts as |tradecraft name|}}
      <div
        class="tradecraft-container tgrid gi6"
        data-tooltip-class="teriock-no-tables"
        {{#if (and (not (eq ../index "artisan")) (not (eq ../index "scholar")) (not (eq ../index "p1")))}}
          data-tooltip-direction="RIGHT"
        {{else}}
          data-tooltip-direction="LEFT"
        {{/if}}
        data-tooltip-identifier="tradecraft:{{ name }}"
      >
        <button
          id="{{ @root/appId }}-tradecraft-{{ name }}-competence"
          class='
            tradecraft-panel-symbol
            ch-tradecraft-pro-box
            grid-fill
            affix-icon
            competence
            updatable
            {{formClasses
            @root/document
            path=(concat
            "system.tradecrafts."
            name
            ".competence.raw")}}
          '
          type="button"
          data-action="updatePaths"
          data-icon="{{ tradecraft.icon }}"
          data-paths="system.tradecrafts.{{ name }}.competence.raw system.tradecrafts.{{ name }}.score system.tradecrafts.{{ name }}.bonus"
          data-title="{{ tradecraft.label }}"
          data-tooltip-class=""
          data-tooltip-direction="LEFT"
          data-tooltip='{{path @root/system.tradecrafts name "competence.description"}}'
        >
          <i class='unselected {{path @root/tradecraftDisplay name "competenceIconClass"}}'></i>
          <i class='selected {{path @root/tradecraftDisplay name "sourceCompetenceIconClass"}}'></i>
        </button>
        <button id="{{ @root/appId }}-tradecraft-{{ name }}-roll" class="tbutton tradecraft-panel-name thover gi3 draggable" type="button" data-action="rollTradecraft" data-disable="false" data-tradecraft="{{ name }}" data-uuid="{{lookup @root/tradecraftMacros name}}">{{ tradecraft.label }}</button>
        <button
          id="{{ @root/appId }}-tradecraft-{{ name }}-score"
          class='
            tradecraft-panel-symbol
            affix
            updatable
            {{formClasses
            @root/document
            path=(concat
            "system.tradecrafts."
            name
            ".score")}}
          '
          type="button"
          data-action="updatePaths"
          data-icon="{{ tradecraft.icon }}"
          data-paths="system.tradecrafts.{{ name }}.competence.raw system.tradecrafts.{{ name }}.score system.tradecrafts.{{ name }}.bonus"
          data-title="{{ tradecraft.label }}"
          data-tooltip='{{path @root/tradecraftDisplay name "scoreLabel"}}'
          data-tooltip-direction="RIGHT"
          data-tooltip-class=""
        >
          <span class="unselected">
            <span class="tradecraft-score-input tcenter ttransparent">
              {{path @root/system.tradecrafts name "score"}}
            </span>
          </span>
          <span class="selected">
            <span class="tradecraft-score-input tcenter ttransparent">
              {{path @root/system._source.tradecrafts name "score"}}
            </span>
          </span>
        </button>
        <div class="tradecraft-panel-symbol">
          {{numberFormat
            (path @root/system.tradecrafts name 'value')
            sign=true
          }}
        </div>
      </div>
    {{/each}}
  </div>
</div>
