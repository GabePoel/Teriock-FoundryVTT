<div class="ch-attribute-box tbox toutline">
  {{infoIcon "core:initiative"}}
  <div class="tgrid g4 tradecraft-panel">
    <div class="attribute-container tgrid g4 gi4" data-tooltip-direction="UP">
      <div
        class="tsubtle tcenter"
        data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.AttributeBox.competence.tooltip"}}'
      >
        {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.AttributeBox.competence.label"}}
        {{infoIcon "core:competence"}}
      </div>
      <div
        class="tsubtle tcenter gi2"
        data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.InitiativeBox.bonus.tooltip"}}'
      >
        {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.InitiativeBox.bonus.label"}}
      </div>
      <div
        class="tsubtle tcenter"
        data-tooltip='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.InitiativeBox.modifier.tooltip"}}'
      >
        {{localize "TERIOCK.SHEETS.Actor.SIDEBAR.InitiativeBox.modifier.label"}}
      </div>
    </div>
    <div class="attribute-container tgrid g4 gi4" data-tooltip-direction="LEFT">
      <button
        id="{{ @root/appId }}-initiative-competence"
        class='
          tcolored
          tcenter
          grid-fill
          affix-icon
          competence
          updatable
          {{formClasses
          @root/document
          path="system.initiative.competence.raw"}}
        '
        type="button"
        data-action="updatePaths"
        data-icon="{{ TERIOCK.DISPLAY.icons.manifest.roll.initiative }}"
        data-paths="system.initiative.competence.raw system.initiative.bonus"
        data-title='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.InitiativeBox.label"}}'
        data-tooltip="{{ system.initiative.competence.description }}"
        data-tooltip-class=""
      >
        <i class="unselected {{ system.initiative.competence.iconClass }}"></i>
        <i
          class='selected {{path TERIOCK.CONFIG.competence.levels system._source.initiative.competence.raw "simpleIconClass"}}'
        ></i>
      </button>
      <button
        id="{{ @root/appId }}-initiative-bonus"
        class='tcenter affix updatable gi2 {{formClasses @root/document path="system.initiative.bonus"}}'
        type="button"
        data-action="updatePaths"
        data-icon="{{ TERIOCK.DISPLAY.icons.manifest.roll.initiative }}"
        data-paths="system.initiative.competence.raw system.initiative.bonus"
        data-title='{{localize "TERIOCK.SHEETS.Actor.SIDEBAR.InitiativeBox.label"}}'
      >
        <span class="unselected"><span class="tcolored">{{ system.initiative.bonus }}</span></span>
        <span class="selected"><span class="tcolored">{{ system._source.initiative.bonus }}</span></span>
      </button>
      <div class="tcolored tcenter">
        {{numberFormat
          system.initiative.value
          sign=true
        }}
      </div>
    </div>
  </div>
</div>
