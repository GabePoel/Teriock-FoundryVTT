<div class="teriock-block-display">
  {{infoIcon "core:price"}}
  <div class="money-panels tgrid g3">
    {{#each TERIOCK.CONFIG.currency as |currency id|}}
      <label class="money-panel-container">
        <div class="money-icon tcenter timage" data-src='{{path @root/TERIOCK.CONFIG.currency id "img"}}'>
          <img src='{{path @root/TERIOCK.CONFIG.currency id "img"}}' data-openable="true" alt="" loading="lazy" />
        </div>
        <div class="money-panel tgrid g4">
          {{formInput
            (path ../systemFields.money "fields" id)
            id=(concat @root/appId "-currency-" id)
            classes="tgrid-item gi1 money-panel-input tgrid-item tcenter"
            dataset=(object tooltip=(minLen (path ../system.money id) 4) noScroll="true")
            placeholder="0"
            value=(path ../system.money id)
          }}
          <div class="money-info tsubtle tcenter gi3">
            <div class="money-name">{{ currency.label }}</div>
            <div class="money-value">
              {{localize
                "TERIOCK.SHEETS.Actor.TABS.Inventory.money.value"
                value=currency.conversion
                weight=currency.weight
              }}
            </div>
          </div>
        </div>
      </label>
    {{/each}}
    <div class="money-panel-container">
      <div class="money-icon tcenter timage" data-src="{{ currencyImages.debt }}">
        <img
          src="{{ @root/TERIOCK.DISPLAY.thumbnails.manifest.currency.debt }}"
          data-openable="true"
          alt=""
          loading="lazy"
        />
      </div>
      <div class="money-panel tgrid g4">
        <button
          id="{{ @root/appId }}-currency-debt"
          class="tgrid-item gi1 money-panel-input tcenter updatable"
          type="button"
          data-action="updatePaths"
          data-icon="{{ TERIOCK.DISPLAY.icons.manifest.ui.interest }}"
          data-paths="system.money.debt system.interestRate"
          data-tooltip="{{minLen system.money.debt 4}}"
        >
          {{ system.money.debt }}
        </button>
        <div class="money-info tsubtle tcenter gi3">
          <div class="money-name">{{localize "TERIOCK.TERMS.Currency.debt"}}</div>
          <div class="money-value">
            {{localize
              "TERIOCK.SYSTEMS.BaseActor.FIELDS.interestRate.daily"
              rate=system.interestRate
            }}
          </div>
        </div>
      </div>
    </div>
  </div>
  {{!-- prettier-ignore --}}
  <output
    class="money-total{{#if (lt system.money.total 0)}} tred{{/if}}"
    for='{{#each TERIOCK.CONFIG.currency as |currency id|}}{{concat concat @root/appId "-currency-" id " "}}{{/each}}{{concat @root/appId "-currency-debt"}}'
  >
    {{ system.money.total }}
    ₲&nbsp;&nbsp;&nbsp;&nbsp;
    {{ system.weight.money }}
    lb
  </output>
</div>
