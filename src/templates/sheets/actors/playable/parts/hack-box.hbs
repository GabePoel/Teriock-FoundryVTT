<div class="tgrid g7">
  {{#each @root/hackParts as |hack|}}
    <button
      id="{{ @root/appId }}-hack-{{ hack.part }}"
      class="tbutton thover hack-marker-box grid-fill"
      type="button"
      data-action="takeHack"
      data-part="{{ hack.part }}"
      data-tooltip="{{ hack.label }}"
    >
      <i class="fa-fw {{ hack.fill }} {{ hack.icon }}"></i>
    </button>
  {{/each}}
</div>
