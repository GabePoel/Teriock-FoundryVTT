<section class="actor-tab notes tab details-tab {{ tabClass }}" data-group="primary" data-tab="details">
  <h1>{{localize "TERIOCK.SHEETS.Actor.TABS.Details.title"}}</h1>
  <div class="actor-tab-page">
    <div class="tgrid g2 details-columns">
      <div class="teriock-block-display details-movement">
        <div
          class="actor-shortbox actor-movement-box"
          data-tooltip-class="teriock-no-tables"
          data-tooltip-direction="LEFT"
          data-tooltip-identifier="core:movement-speed"
        >
          <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.movementSpeed.label"}}</div>
          <div class="actor-shortbox-value">
            {{{ system.movementSpeed }}}
            {{localize "TERIOCK.SHEETS.Actor.TABS.Details.movementSpeed.rate"}}
          </div>
        </div>
        <div class="teriock-block-display-divider"></div>
        <div class="tgrid g3">
          {{#each TERIOCK.config.character.movement as |config key|}}
            <div class="gi2">
              {{{ config.label }}}
            </div>
            <div
              class="
                tcolored
                thover
                affix
                {{#if (and
                @root/highlightModified
                (not (eq
                (lookup @root/system.speedAdjustments key)
                (lookup @root/system._source.speedAdjustments key))))}}
                  modified
                {{/if}}
              "
              data-action="updatePaths"
              data-icon="{{ config.icon }}"
              data-paths="system.speedAdjustments.{{ key }}"
            >
              <div class="unselected">
                {{path @root/TERIOCK.config.character.speed (lookup @root/system.speedAdjustments key) "label"}}
              </div>
              <div class="selected">
                {{path @root/TERIOCK.config.character.speed (lookup @root/system._source.speedAdjustments key) "label"}}
              </div>
            </div>
          {{/each}}
        </div>
      </div>
      <div class="tgrid-item details-right-column">
        <div class="teriock-block-display details-senses">
          <div class="tgrid g3">
            <div class="gi2 tsubtle">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.sense.label"}}</div>
            <div class="tcenter tsubtle">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.sense.range"}}</div>
            {{#each TERIOCK.config.character.sense as |config key|}}
              {{#unless config.hidden}}
                <div class="gi2">
                  {{{ config.label }}}
                </div>
                <div
                  class="
                    tcenter
                    affix
                    {{#if (and
                    @root/highlightModified
                    (not (eq (path ../system.senses key) (path ../system._source.senses key))))}}
                      modified
                    {{/if}}
                  "
                  data-action="updatePaths"
                  data-icon="{{ config.icon }}"
                  data-paths="system.senses.{{ key }}"
                >
                  <div class="unselected">
                    <span class="tcolored thover tcenter ttransparent">{{{path @root/senses key "value"}}}</span>
                  </div>
                  <div class="selected">
                    <span class="tcolored thover tcenter ttransparent">{{{path @root/senses key "source"}}}</span>
                  </div>
                </div>
              {{/unless}}
            {{/each}}
          </div>
        </div>
        <div class="teriock-block-display details-physical">
          <div class="carrying-box-main" data-tooltip-identifier="core:size">
            <div class="actor-shortbox actor-size-box">
              <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.size.label"}}</div>
              {{formHover
                classes="actor-weight-input actor-smallbox-value details-value"
                selected=system._source.size.value
                unselected=system.size.value
                action="updatePaths"
                paths="system.size.value"
                icon=TERIOCK.display.icons.manifest.species.size
                dataset=(object
                  tooltip=(localize "TERIOCK.SHEETS.Actor.TABS.Details.size.description" category=system.size.category reach=system.size.reach)
                  tooltipDirection="DOWN"
                  tooltipClass="")
              }}
            </div>
            <div class="actor-shortbox actor-weight-box">
              <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.weight.label"}}</div>
              {{formHover
                classes="actor-weight-input actor-smallbox-value details-value"
                selected=system._source.weight.self
                unselected=system.weight.self
                selectedFormat=(localize
                  "TERIOCK.MODELS.BaseUnit.FORMAT"
                  number=system.weight.self
                  unit=(localize "TERIOCK.SHEETS.Actor.TABS.Details.weight.unit"))
                unselectedFormat=(localize
                  "TERIOCK.MODELS.BaseUnit.FORMAT"
                  number=system.weight.self
                  unit=(localize "TERIOCK.SHEETS.Actor.TABS.Details.weight.unit"))
                action="updatePaths"
                paths="system.weight.self"
                nullValue=(localize "COMMON.Default")
                icon=TERIOCK.display.icons.manifest.equipment.weight
                dataset=(object
                  tooltip=(localize
                    "TERIOCK.SHEETS.Actor.TABS.Details.weight.includingEquipment" value=system.weight.value)
                  tooltipDirection="DOWN"
                  tooltipClass="")
              }}
            </div>
            <div class="actor-shortbox actor-carrying-box">
              <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.label"}}</div>
              <div
                class="actor-smallbox-value tcenter details-value"
                data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.includingSelf" value=system.weight.value}}'
                data-tooltip-class=""
                data-tooltip-direction="DOWN"
              >
                {{{ system.weight.carried }}}
                {{localize "TERIOCK.SHEETS.Actor.TABS.Details.weight.unit"}}
              </div>
            </div>
          </div>
          <div class="teriock-block-display-divider"></div>
          <div class="tgrid g3" data-tooltip-identifier="core:carrying-capacity">
            <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.light"}}</div>
            <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.heavy"}}</div>
            <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.max"}}</div>
            <div
              class="
                tcenter
                tround
                {{#if (gte system.weight.carried system.carryingCapacity.light)}}
                  tred
                {{/if}}
              "
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.lightCapacity"}}'
              data-tooltip-direction="DOWN"
              data-tooltip-class=""
            >
              {{{ system.carryingCapacity.light }}}
              {{localize "TERIOCK.SHEETS.Actor.TABS.Details.weight.unit"}}
            </div>
            <div
              class="
                tcenter
                tround
                {{#if (gte system.weight.carried system.carryingCapacity.heavy)}}
                  tred
                {{/if}}
              "
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.heavyCapacity"}}'
              data-tooltip-direction="DOWN"
              data-tooltip-class=""
            >
              {{{ system.carryingCapacity.heavy }}}
              {{localize "TERIOCK.SHEETS.Actor.TABS.Details.weight.unit"}}
            </div>
            <div
              class="
                tcenter
                tround
                {{#if (gte system.weight.carried system.carryingCapacity.max)}}
                  tred
                {{/if}}
              "
              data-tooltip='{{localize "TERIOCK.SHEETS.Actor.TABS.Details.carrying.maxCapacity"}}'
              data-tooltip-direction="DOWN"
              data-tooltip-class=""
            >
              {{{ system.carryingCapacity.max }}}
              {{localize "TERIOCK.SHEETS.Actor.TABS.Details.weight.unit"}}
            </div>
          </div>
        </div>
      </div>
      <div class="teriock-block-display details-limits">
        <div class="tgrid g2">
          <div
            class="actor-shortbox"
            data-action="toggleDocs"
            data-path="system.curseDocuments"
            data-tooltip-class="teriock-no-tables"
            data-tooltip-direction="LEFT"
            data-tooltip-identifier="keyword:curse"
          >
            <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.curses.label"}}</div>
            <div
              class="
                actor-smallbox-value
                details-value
              "
            >
              {{formHover
                unselected=system.curses.value
                selected=system.curses.value
                action="toggleDocs"
                dataset=(object path="system.curseDocuments")
                tag="span"
              }}
              &nbsp;/&nbsp;
              {{formHover
                action="updatePaths"
                icon=TERIOCK.display.icons.manifest.power.curse
                paths="system.curses.max"
                selected=(asInf system._source.curses.max)
                tag="span"
                unselected=(asInf system.curses.max)
              }}
            </div>
          </div>
          <div class="actor-shortbox">
            <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.rotators.label"}}</div>
            <div
              class="
                actor-smallbox-value
                details-value
              "
            >
              {{formHover
                unselected=system.rotators.value
                selected=system.rotators.value
                action="toggleDocs"
                dataset=(object path="system.rotatorDocuments")
                tag="span"
              }}
              &nbsp;/&nbsp;
              {{formHover
                action="updatePaths"
                icon=TERIOCK.display.icons.manifest.maneuver.passive
                paths="system.rotators.max"
                selected=(asInf system._source.rotators.max)
                tag="span"
                unselected=(asInf system.rotators.max)
              }}
            </div>
          </div>
        </div>
      </div>
      <div class="teriock-block-display details-detection">
        <div class="actor-shortbox">
          <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.hiding.label"}}</div>
          {{formHover
            classes="actor detection-input actor-smallbox-value details-value"
            action="updatePaths"
            icon=TERIOCK.display.icons.manifest.attribute.snk
            nullValue=system.detection.hiding
            paths="system.detection.hiding"
            selected=system._source.detection.hiding
            unselected=system.detection.hiding
          }}
        </div>
        <div class="actor-shortbox">
          <div class="tsubtle tcenter">{{localize "TERIOCK.SHEETS.Actor.TABS.Details.perceiving.label"}}</div>
          {{formHover
            classes="actor detection-input actor-smallbox-value details-value"
            action="updatePaths"
            icon=TERIOCK.display.icons.manifest.attribute.per
            nullValue=system.detection.perceiving
            paths="system.detection.perceiving"
            selected=system._source.detection.perceiving
            unselected=system.detection.perceiving
          }}
        </div>
      </div>
    </div>
    <div class="teriock-block-display actor-notes-content">
      <prose-mirror name="system.notes" value="{{ system.notes }}" toggled="true" editable="editable">
        {{#if (exists enrichedNotes)}}
          {{{ enrichedNotes }}}
        {{else}}
          {{localize "TERIOCK.SHEETS.Actor.TABS.Details.notes.placeholder"}}
        {{/if}}
      </prose-mirror>
    </div>
  </div>
</section>
