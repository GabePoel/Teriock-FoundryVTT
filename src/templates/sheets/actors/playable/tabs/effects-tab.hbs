<section class="actor-tab conditions tab {{ tabClass }}" data-group="primary" data-tab="effects">
  <h1>{{localize "TERIOCK.SHEETS.Actor.TABS.Effects.title"}}</h1>
  <div class="actor-tab-page">
    <div class="teriock-block-display">
      {{> "teriock/ui/preview"
        @root.previews.effects
      }}
    </div>
    <div class="teriock-block-display">
      <div class="tgrid g4 condition-toggle-container">
        {{#each TERIOCK.STATUSES.conditions as |condition key|}}
          <button
            id="{{ @root/appId }}-condition-{{ key }}"
            class="
              tbutton
              condition-toggle
              {{#unless (lookup ../conditions key)}}
                inactive
              {{/unless}}
            "
            type="button"
            data-action="toggleCondition"
            data-condition="{{{ key }}}"
            data-tooltip='
              {{localize "TERIOCK.SHEETS.Actor.TABS.Effects.toggle" name=condition.name state=(ifThen
              (lookup ../conditions key)
              (localize "TERIOCK.SHEETS.Actor.TABS.Effects.off")
              (localize "TERIOCK.SHEETS.Actor.TABS.Effects.on"))}}
            '
          >
            {{infoIcon (concat "condition:" condition.system.identifier)}}
            <span class="condition-image-container">
              <span class="condition-image">
                <img src="{{ condition.img }}" alt="{{ condition.name }}" loading="lazy" />
              </span>
            </span>
            <span class="condition-label tsubtle">{{ condition.name }}</span>
          </button>
        {{/each}}
      </div>
    </div>
  </div>
</section>
