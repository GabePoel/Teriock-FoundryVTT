<section class="actor-tab affinities tab {{ tabClass }}" data-group="primary" data-tab="affinities">
  <h1>{{localize "TERIOCK.SHEETS.Actor.TABS.Affinities.title"}}</h1>
  <div class="actor-tab-page">
    <div class="teriock-block-display">
      <div class="tgrid g4 condition-toggle-container">
        {{#each affinityButtons as |b|}}
          <button
            id="{{ @root/appId }}-affinity-{{ b.affinityType }}"
            class="tbutton condition-toggle"
            type="button"
            data-disable="false"
            data-action="rollAffinity"
            data-affinity-type="{{ b.affinityType }}"
            data-tooltip="{{ b.tooltip }}"
          >
            {{infoIcon (concat "keyword:" b.affinityType)}}
            <span class="condition-image-container">
              <span class="condition-image">
                <img src="{{ b.img }}" alt="" loading="lazy" />
              </span>
            </span>
            <span class="condition-label tsubtle">{{ b.label }}</span>
          </button>
        {{/each}}
      </div>
    </div>
    <div class="teriock-block-display">
      {{> "teriock/ui/preview"
        @root.previews.affinities
      }}
    </div>
  </div>
</section>
