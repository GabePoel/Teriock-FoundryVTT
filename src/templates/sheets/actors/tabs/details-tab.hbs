<section class="actor-tab details-tab tab {{ tab.cssClass }}" data-group="{{ tab.group }}" data-tab="{{ tab.id }}">
  {{#if @root/tabHeaders}}
    <h1>
      {{localize tab.label}}
    </h1>
  {{/if}}
  <div class="actor-tab-page">
    <div class="tgrid g2 details-columns">
      {{#unless environment}}
        <div class="teriock-block-display details-movement">
          {{infoIcon
            "core:movement-speed"
            noTable=true
          }}
          <div class="actor-stat">
            <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.movementSpeed.label"}}</div>
            {{formHover
              document
              cssClass="actor-stat-value updatable"
              action="updatePaths"
              icon=TERIOCK.DISPLAY.icons.manifest.movement.walk
              path="system.movementSpeed"
              selected=movementSpeed.source
              unselected=movementSpeed.data
            }}
          </div>
          <div class="teriock-block-display-divider"></div>
          <div class="details-list">
            {{#each TERIOCK.CONFIG.actor.movement as |config key|}}
              {{#if (lookup @root/activeSpeedAdjustments key)}}
                <div
                  class="
                    details-active
                    {{#if config.movementAction}}
                      thover
                    {{/if}}
                  "
                  {{#if config.movementAction}}
                    data-action="setMovementAction"
                    data-movement-action="{{ config.movementAction }}"
                  {{/if}}
                  data-tooltip='{{localize "TERIOCK.SHEETS.Actor.Details.movementSpeed.active"}}'
                  data-tooltip-direction="LEFT"
                >
                  {{{ config.label }}}
                </div>
              {{else}}
                <div
                  {{#if config.movementAction}}
                    class="thover"
                    data-action="setMovementAction"
                    data-movement-action="{{ config.movementAction }}"
                  {{/if}}
                >
                  {{{ config.label }}}
                </div>
              {{/if}}
              <button
                id="{{ @root/appId }}-speed-{{ key }}"
                class='
                  affix
                  updatable
                  {{formClasses
                  @root/document
                  path=(concat
                  "system.speedAdjustments."
                  key)}}
                '
                type="button"
                data-action="updatePaths"
                data-icon="{{ config.icon }}"
                data-paths="system.speedAdjustments.{{ key }}"
              >
                <span class="unselected">
                  {{path @root/TERIOCK.CONFIG.actor.speedAdjustments (lookup @root/system.speedAdjustments key) "label"}}
                </span>
                <span class="selected">
                  {{path @root/TERIOCK.CONFIG.actor.speedAdjustments (lookup @root/system._source.speedAdjustments key) "label"}}
                </span>
              </button>
            {{/each}}
          </div>
          {{#if terrains.length}}
            <div class="teriock-block-display-divider"></div>
            <div class="details-terrains">
              {{#each terrains as |terrain|}}
                <span class="details-terrain thelp" data-tooltip="TERIOCK.SHEETS.Actor.Details.terrains.label">
                  {{ terrain.label }}
                </span>
              {{/each}}
            </div>
          {{/if}}
        </div>
        <div class="details-right-column">
          <div class="teriock-block-display details-senses">
            <div class="details-list">
              <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.sense.label"}}</div>
              <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.sense.range"}}</div>
              {{#each TERIOCK.CONFIG.actor.senses as |config key|}}
                {{#unless config.hidden}}
                  <div>
                    {{{ config.label }}}
                  </div>
                  <button
                    id="{{ @root/appId }}-sense-{{ key }}"
                    class='
                      affix
                      updatable
                      {{formClasses
                      @root/document
                      path=(concat
                      "system.senses."
                      key)}}
                    '
                    type="button"
                    data-action="updatePaths"
                    data-icon="{{ config.icon }}"
                    data-paths="system.senses.{{ key }}"
                  >
                    <span class="unselected">{{{path @root/senses key "value"}}}</span>
                    <span class="selected">{{{path @root/senses key "source"}}}</span>
                  </button>
                {{/unless}}
              {{/each}}
            </div>
          </div>
          <div class="teriock-block-display">
            {{infoIcon "condition:hidden"}}
            <div class="actor-stats">
              <div class="actor-stat">
                <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.hiding.label"}}</div>
                {{formHover
                  document
                  cssClass="actor-stat-value updatable"
                  action="updatePaths"
                  icon=TERIOCK.DISPLAY.icons.manifest.attribute.snk
                  path="system.detection.hiding"
                  selected=system._source.detection.hiding
                  unselected=system.detection.hiding
                }}
              </div>
              <div class="actor-stat">
                <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.perceiving.label"}}</div>
                {{formHover
                  document
                  cssClass="actor-stat-value updatable"
                  action="updatePaths"
                  icon=TERIOCK.DISPLAY.icons.manifest.attribute.per
                  path="system.detection.perceiving"
                  selected=system._source.detection.perceiving
                  unselected=system.detection.perceiving
                }}
              </div>
            </div>
          </div>
          <div class="teriock-block-display">
            {{infoIcon
              "keyword:curse"
              noTable=true
            }}
            <div class="actor-stat">
              <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.curses.label"}}</div>
              <div class="actor-stat-value details-fraction">
                {{formHover
                  document
                  cssClass="updatable"
                  unselected=system.curses.value
                  selected=system.curses.value
                  action="toggleDocs"
                  dataset=(object path="system.curseDocuments")
                }}
                /
                {{formHover
                  document
                  cssClass="updatable"
                  action="updatePaths"
                  icon=TERIOCK.DISPLAY.icons.manifest.document.curse
                  path="system.curses.max"
                  selected=(asInf system._source.curses.max)
                  unselected=(asInf system.curses.max)
                }}
              </div>
            </div>
          </div>
        </div>
      {{/unless}}
      <div class="teriock-block-display gi2">
        <div class="actor-stats">
          {{infoIcon
            "core:size"
            noTable=true
          }}
          <div class="actor-stat">
            <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.size.label"}}</div>
            {{formHover
              document
              cssClass="actor-stat-value updatable"
              selected=system._source.size.value
              unselected=system.size.value
              action="updatePaths"
              path="system.size.value"
              icon=TERIOCK.DISPLAY.icons.manifest.species.size
            }}
          </div>
          <div class="actor-stat">
            <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.size.category"}}</div>
            <div class="actor-stat-value">{{localize system.size.label}}</div>
          </div>
          <div class="actor-stat">
            <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.size.space"}}</div>
            <div class="actor-stat-value">{{ sizeDetails.space }}</div>
          </div>
          <div class="actor-stat">
            <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.size.reach"}}</div>
            <div class="actor-stat-value">{{{ sizeDetails.reach }}}</div>
          </div>
        </div>
        {{#unless environment}}
          <div class="teriock-block-display-divider"></div>
          <div class="actor-stats">
            {{infoIcon
              "core:weight"
              noTable=true
            }}
            <div class="actor-stat">
              <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.weight.label"}}</div>
              {{formHover
                document
                cssClass="actor-stat-value updatable"
                selected=weight.source
                unselected=weight.data
                action="updatePaths"
                path="system.weight.self"
                icon=TERIOCK.DISPLAY.icons.manifest.equipment.weight
              }}
            </div>
            <div class="actor-stat">
              <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Details.weight.total"}}</div>
              <div class="actor-stat-value">
                {{{ system.weight.value }}}
                {{localize "TERIOCK.SHEETS.Actor.Details.weight.unit"}}
              </div>
            </div>
          </div>
          <div class="teriock-block-display-divider"></div>
          <div class="details-taxonomy">
            {{#each taxonomy as |tag|}}
              <span class="details-tag thelp" data-tooltip="{{ tag.tooltip }}">
                {{ tag.label }}
              </span>
            {{else}}
              <span class="tsubtle">
                {{localize "TERIOCK.SHEETS.Actor.Details.taxonomy.empty"}}
              </span>
            {{/each}}
            {{!-- prettier-ignore --}}
            <button
              id="{{ appId }}-taxonomy"
              class="details-taxonomy-edit"
              type="button"
              data-action="updatePaths"
              data-icon="{{ TERIOCK.DISPLAY.icons.manifest.species.traits }}"
              data-paths="system.traits system.families system.undeadLevel"
              data-tooltip="TERIOCK.SHEETS.Actor.Details.taxonomy.edit"
              {{disabled (not editable)}}
            >
              {{makeIcon TERIOCK.DISPLAY.icons.manifest.ui.edit "button"}}
            </button>
          </div>
        {{/unless}}
      </div>
    </div>
    {{> "teriock/sheets/actors/parts/notes"}}
  </div>
</section>
