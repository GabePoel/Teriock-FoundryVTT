<section class="actor-tab sorcery-tab tab {{ tab.cssClass }}" data-group="{{ tab.group }}" data-tab="{{ tab.id }}">
  {{#if @root/tabHeaders}}
    <h1>
      {{localize tab.label}}
    </h1>
  {{/if}}
  <div class="actor-tab-page">
    <div class="tgrid g3 sorcery-top">
      <div class="teriock-block-display">
        {{infoIcon "ability:rotators"}}
        <div class="actor-stat">
          <div class="tsubtle">{{localize "TERIOCK.SHEETS.Actor.Sorcery.rotators"}}</div>
          <div class="actor-stat-value details-fraction">
            {{formHover
              document
              cssClass="updatable"
              unselected=system.rotators.value
              selected=system.rotators.value
              action="toggleDocs"
              dataset=(object path="system.rotatorDocuments")
            }}
            /
            {{formHover
              document
              cssClass="updatable"
              action="updatePaths"
              icon=TERIOCK.DISPLAY.icons.manifest.maneuver.passive
              path="system.rotators.max"
              selected=(asInf system._source.rotators.max)
              unselected=(asInf system.rotators.max)
            }}
          </div>
        </div>
      </div>
      <div class="teriock-block-display gi2 sorcery-buttons">
        {{!-- prettier-ignore --}}
        <button
          data-action="openUpdater"
          data-updater="ElderSorceryWordsUpdater"
          type="button" {{disabled (not editable)}}
        >
          {{makeIcon TERIOCK.DISPLAY.icons.manifest.ui.edit "button"}}
          {{localize "TERIOCK.SHEETS.Actor.Sorcery.customWords"}}
        </button>
        {{!-- prettier-ignore --}}
        <button
          data-action="takeCommand"
          data-command="elderSorcery"
          data-disable="false"
          type="button"
        >
          {{makeIcon TERIOCK.DISPLAY.icons.manifest.execution.elderSorcery "button"}}
          {{localize "TERIOCK.SHEETS.Actor.Sorcery.create"}}
        </button>
      </div>
    </div>
    <div class="teriock-block-display">
      {{> "teriock/ui/preview"
        @root.previews.sorcery
      }}
    </div>
    <div class="teriock-block-display sorcery-words">{{{ allWords }}}</div>
  </div>
</section>
