<section class="actor-tab tab {{ tab.cssClass }}" data-group="{{ tab.group }}" data-tab="{{ tab.id }}">
  {{#if @root/tabHeaders}}
    <h1>
      {{localize tab.label}}
    </h1>
  {{/if}}
  <div class="actor-tab-page">
    <div class="teriock-block-display">
      {{> "teriock/ui/preview"
        (lookup previews tab.id)
      }}
    </div>
  </div>
</section>
