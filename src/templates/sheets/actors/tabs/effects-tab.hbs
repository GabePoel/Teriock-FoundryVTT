<section class="actor-tab tab {{ tab.cssClass }}" data-group="{{ tab.group }}" data-tab="{{ tab.id }}">
  {{#if @root/tabHeaders}}
    <h1>
      {{localize tab.label}}
    </h1>
  {{/if}}
  <div class="actor-tab-page">
    <div class="teriock-block-display">
      {{> "teriock/ui/preview"
        @root.previews.effects
      }}
    </div>
    <div class="teriock-block-display">
      <div class="tgrid g4 condition-toggle-container">
        {{#each TERIOCK.STATUSES.conditions as |condition key|}}
          <button
            id="{{ @root/appId }}-condition-{{ key }}"
            class="
              tbutton
              condition-toggle
              {{#unless (lookup ../conditions key)}}
                inactive
              {{/unless}}
            "
            type="button"
            data-action="toggleCondition"
            data-condition="{{{ key }}}"
            data-tooltip='
              {{localize "TERIOCK.SHEETS.Actor.Effects.toggle" name=condition.name state=(ifThen
              (lookup ../conditions key)
              (localize "TERIOCK.SHEETS.Actor.Effects.off")
              (localize "TERIOCK.SHEETS.Actor.Effects.on"))}}
            '
          >
            {{infoIcon (concat "condition:" condition.system.slug)}}
            <span class="condition-image-container">
              <span class="condition-image">
                <img src="{{ condition.img }}" alt="{{ condition.name }}" loading="lazy" />
              </span>
            </span>
            <span class="condition-label tsubtle">{{ condition.name }}</span>
          </button>
        {{/each}}
      </div>
    </div>
  </div>
</section>
