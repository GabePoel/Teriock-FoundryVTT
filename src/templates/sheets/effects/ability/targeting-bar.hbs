<div class="teriock-sheet-bar">
  {{#if system.isRanged}}
    {{formUpdater
      document
      icon=TERIOCK.DISPLAY.icons.manifest.ability.range
      info="core:range"
      label="TERIOCK.SYSTEMS.Ability.FIELDS.range.label"
      path="system.range"
    }}
  {{/if}}
  {{formUpdater
    document
    icon=TERIOCK.DISPLAY.icons.manifest.ability.target
    info="core:targets"
    label="TERIOCK.SYSTEMS.Ability.FIELDS.targets.label"
    path="system.targets"
  }}
  {{#unless (eq system.maneuver "passive")}}
    {{formUpdater
      document
      icon=TERIOCK.DISPLAY.icons.manifest.ability.duration
      info="core:duration"
      label="TERIOCK.SYSTEMS.Ability.FIELDS.duration.label"
      path="system.duration"
    }}
  {{/unless}}
</div>
