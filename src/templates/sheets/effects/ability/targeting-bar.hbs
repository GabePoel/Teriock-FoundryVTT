<div class="teriock-sheet-bar">
  {{#if system.isRanged}}
    {{formUpdater
      document
      data=range.data
      icon=TERIOCK.DISPLAY.icons.manifest.ability.range
      info="core:range"
      label=(localize "TERIOCK.SYSTEMS.Ability.FIELDS.range.label")
      path="system.range"
      source=range.source
    }}
  {{/if}}
  {{formUpdater
    document
    icon=TERIOCK.DISPLAY.icons.manifest.ability.target
    info="core:targets"
    label=(localize "TERIOCK.SYSTEMS.Ability.FIELDS.targets.label")
    path="system.targets"
  }}
  {{formUpdater
    document
    abbreviation=""
    data=duration.data
    icon=TERIOCK.DISPLAY.icons.manifest.ability.duration
    info="core:duration"
    label=(localize "TERIOCK.SYSTEMS.Ability.FIELDS.duration.label")
    path="system.duration"
    source=duration.source
  }}
</div>
