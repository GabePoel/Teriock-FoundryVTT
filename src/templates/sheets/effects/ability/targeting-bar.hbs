<div class="teriock-sheet-bar">
  {{#if system.isRanged}}
    {{formUpdater
      document
      abbreviation=(ifThen (eq system.range.unitType "finite") (localize system.range.symbol) "")
      abbreviationTooltip=(ifThen (eq system.range.unitType "finite") system.range.unitName "")
      action="updateUnit"
      data=range.data
      dataset=(object path="system.range")
      icon=TERIOCK.DISPLAY.icons.manifest.ability.range
      info="core:range"
      label=(localize "TERIOCK.SYSTEMS.Ability.FIELDS.range.label")
      path="system.range"
      source=range.source
    }}
  {{/if}}
  {{formUpdater
    document
    icon=TERIOCK.DISPLAY.icons.manifest.ability.target
    info="core:targets"
    label=(localize "TERIOCK.SYSTEMS.Ability.FIELDS.targets.label")
    path="system.targets"
  }}
  {{formUpdater
    document
    action="updateUnit"
    data=duration.data
    dataset=(object path="system.duration")
    icon=TERIOCK.DISPLAY.icons.manifest.ability.duration
    info="core:duration"
    label=(localize "TERIOCK.SYSTEMS.Ability.FIELDS.duration.label")
    path="system.duration"
    source=duration.source
  }}
</div>
