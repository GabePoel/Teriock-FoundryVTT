{{#if (or
  (exists system.costs.primary.gp.formula)
  (exists system.costs.primary.hp.formula)
  (exists system.costs.primary.lp.formula)
  (exists system.costs.primary.mp.formula))
}}
  <div class="teriock-sheet-bar">
    {{#each TERIOCK.CONFIG.stat as |value key|}}
      {{#if (exists (path @root/system.costs.primary key "formula"))}}
        {{formUpdater
          @root/document
          abbreviation=value.abbreviation
          icon=value.icon
          info=value.costIdentifier
          label=(localize "TERIOCK.COSTS.Long.primary" key=value.label)
          path=(concat "system.costs.primary." key ".formula")
          placeholder="0"
        }}
      {{/if}}
    {{/each}}
  </div>
{{/if}}
