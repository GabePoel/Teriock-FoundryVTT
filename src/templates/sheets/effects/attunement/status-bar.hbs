<div class="teriock-sheet-bar">
  {{> "teriock/sheets/shared/forms/kind-form"
    kindValue=system.kind
  }}
  {{formUpdater
    document
    abbreviation=(localize "TERIOCK.SYSTEMS.Attunable.FIELDS.tier.abbreviation")
    action=(ifThen (not system.target) "updatePaths" "")
    icon=TERIOCK.DISPLAY.icons.manifest.attunable.tier
    path="system.tier"
    placeholder="0"
  }}
</div>
