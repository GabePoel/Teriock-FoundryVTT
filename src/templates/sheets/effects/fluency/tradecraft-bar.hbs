<div class="teriock-sheet-bar">
  {{> "teriock/sheets/shared/forms/kind-form"
    kindValue=system.kind
  }}
  {{formUpdater
    document
    action="updateTradecraft"
    data=(path TERIOCK.config.tradecraft.fields system.field "label")
    icon=(path TERIOCK.config.tradecraft.fields system.field "icon")
    label=(localize "TERIOCK.COMMON.Field")
    path="system.field"
    source=(path TERIOCK.config.tradecraft.fields system._source.field "label")
  }}
  {{formUpdater
    document
    action="updateTradecraft"
    data=(path TERIOCK.config.tradecraft.tradecrafts system.tradecraft "label")
    icon=(path TERIOCK.config.tradecraft.tradecrafts system.tradecraft "icon")
    label=(localize "TERIOCK.COMMON.Tradecraft")
    path="system.tradecraft"
    source=(path TERIOCK.config.tradecraft.tradecrafts system._source.tradecraft "label")
  }}
</div>
