<div class="teriock-sheet-bar">
  {{> "teriock/sheets/shared/forms/kind-form"
    kindValue=system.kind
  }}
  {{formUpdater
    document
    action="openUpdater"
    dataset=(object updater="FluencyTradecraftUpdater")
    icon=(path TERIOCK.CONFIG.tradecraft.fields system.field "icon")
    info="core:tradecrafts"
    label="TERIOCK.COMMON.Field"
    path="system.field"
  }}
  {{formUpdater
    document
    action="openUpdater"
    dataset=(object updater="FluencyTradecraftUpdater")
    icon=(path TERIOCK.CONFIG.tradecraft.tradecrafts system.tradecraft "icon")
    info=(concat "tradecraft:" system.tradecraft)
    label="TERIOCK.COMMON.Tradecraft"
    path="system.tradecraft"
  }}
</div>
