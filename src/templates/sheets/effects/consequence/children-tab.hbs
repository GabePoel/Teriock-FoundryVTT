<section
  class="
    children
    scrollable
    tab
    teriock
    {{#if tab.active}}
      active
    {{/if}}
  "
  data-group="{{ tab.group }}"
  data-tab="{{ tab.id }}"
>
  {{#if (not @root/document.actor)}}
    <ul class="notification-container">
      <li class="notification warning">
        <span>{{localize "TERIOCK.SHEETS.ApplicableEffect.noItems"}}</span>
      </li>
    </ul>
  {{/if}}
  {{> "teriock/sheets/shared/children"}}
</section>
