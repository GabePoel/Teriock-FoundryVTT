<section
  class="
    children
    scrollable
    tab
    teriock
    {{#if tab.active}}
      active
    {{/if}}
  "
  data-group="{{ tab.group }}"
  data-tab="{{ tab.id }}"
>
  {{#if (exists @root/dependents)}}
    <div class="teriock-form-container">
      {{> "teriock/shared/field-list"
        @root/dependents
      }}
    </div>
  {{/if}}
  {{> "teriock/sheets/shared/children"}}
</section>
