<div>
  {{#if title.show}}
    <header class="journal-page-header">
      <h
        {{ title.level }}
      >
        {{ name }}
      </h>
    </header>
  {{/if}}
  {{#unless document.system.words.isEmpty}}
    {{formInput
      document.system.schema.fields.words
      value=source.system.words
      readonly=true
    }}
  {{/unless}}
</div>
