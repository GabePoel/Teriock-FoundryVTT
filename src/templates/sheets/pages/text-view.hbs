<div>
  {{#if title.show}}
    <header class="teriock-page-header journal-page-header">
      <div
        class="teriock-page-img"
        data-src="{{ img }}"
        {{#if (exists system.color)}}
        style="outline-color: {{{ system.color.css }}}"
        {{/if}}
      >
        <img
          class="profile-img"
          src="{{ img }}"
          data-edit="{{ imgPath }}"
          alt=""
          {{#if editable}}
          data-action="editImage"
          {{/if}}
          title="{{ name }}"
        />
      </div>
      {{{concat "<h" title.level ">" name "</h" title.level ">"}}}
    </header>
    {{#if (exists displayTags)}}
      <div class="teriock-page-tags">
        {{#each displayTags as |tag|}}
          <span
            class="page-tag"
            {{#if (exists tag.tooltip)}}
            data-tooltip="{{ tag.tooltip }}"
            {{/if}}
          >
            {{tag.label}}
          </span>
        {{/each}}
      </div>
    {{/if}}
  {{/if}}
  <section class="journal-page-content">
    {{#each displayFields}}
      {{#if classes}}
        <aside class="teriock-sheet-section-container">
          {{formGroup
            schema
            classes=(toClass classes)
            dataset=(object disable="true")
            disabled=true
            enriched=enriched
            label=label
            value=value
            rootId=@root/appId
            toggled=true
          }}
        </aside>
      {{else}}
        {{{ enriched }}}
      {{/if}}
    {{/each}}
  </section>
</div>
