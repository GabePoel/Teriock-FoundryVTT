{{formUpdater
  document
  action=(ifThen kindPath "updatePaths" "openUpdater")
  dataset=(object updater=(ifThen kindUpdater kindUpdater "KindUpdater"))
  path=(ifThen kindPath kindPath "system.kind")
  icon=(path metadata.kinds (ifThen kindIcon kindIcon kindValue) "icon")
  color=(path metadata.kinds kindValue "color")
}}
