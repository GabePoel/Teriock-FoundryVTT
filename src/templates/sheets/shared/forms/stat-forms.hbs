{{#each TERIOCK.config.stat as |config key|}}
  {{#if config.pool.enabled}}
    {{formUpdater
      @root/document
      abbreviation=(localize config.abbreviation)
      action="updateStatDice"
      data=(localize
        "TERIOCK.MODELS.BaseStatPool.PANELS.summary"
        formula=(path @root/system.statDice key "formula")
        value=(path @root/system.statDice key "value"))
      dataset=(object stat=key)
      icon=(path @root/system.statDice key "icon")
      source=(ifThen
        (eq (path @root/system.statDice key "formula") (path @root/system._source.statDice key "formula"))
        (localize
          "TERIOCK.MODELS.BaseStatPool.PANELS.summary"
          formula=(path @root/system.statDice key "formula")
          value=(path @root/system.statDice key "value"))
        (path @root/system._source.statDice key "formula"))
      label=(localize (concat "TERIOCK.SYSTEMS.StatGiver.FIELDS.statDice." key ".label"))
    }}
  {{/if}}
{{/each}}
