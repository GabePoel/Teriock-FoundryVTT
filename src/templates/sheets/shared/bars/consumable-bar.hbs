{{#if system.consumable}}
  <div class="teriock-sheet-bar">
    {{formUpdater
      document
      data=(localize "TERIOCK.SYSTEMS.Consumable.EMBED.remaining" value=system.quantity.value)
      icon=TERIOCK.DISPLAY.icons.manifest.ui.quantity
      label=(localize "TERIOCK.SYSTEMS.Consumable.FIELDS.quantity.value.label")
      path="system.quantity.value"
      source=(localize "TERIOCK.SYSTEMS.Consumable.EMBED.remaining" value=system._source.quantity.value)
    }}
    {{formUpdater
      document
      data=(localize "TERIOCK.SYSTEMS.Consumable.PANELS.max" value=(asInf system.quantity.max))
      icon=TERIOCK.DISPLAY.icons.manifest.ui.maximum
      label=(localize "TERIOCK.SYSTEMS.Consumable.FIELDS.quantity.maxFormula.label")
      path="system.quantity.maxFormula"
      placeholder=(localize "TERIOCK.SYSTEMS.Consumable.PANELS.noMax")
      source=(localize "TERIOCK.SYSTEMS.Consumable.PANELS.max" value=(asInf system._source.quantity.maxFormula))
    }}
    {{formUpdater
      document
      data=(localize "TERIOCK.SYSTEMS.Consumable.EMBED.perUse" value=system.consumption.amount)
      icon=TERIOCK.DISPLAY.icons.manifest.ui.amount
      label=(localize "TERIOCK.SYSTEMS.Consumable.FIELDS.consumption.amount.label")
      path="system.consumption.amount"
      source=(localize "TERIOCK.SYSTEMS.Consumable.EMBED.perUse" value=system._source.consumption.amount)
    }}
  </div>
{{/if}}
