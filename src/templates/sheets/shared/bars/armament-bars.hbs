{{#if (or system.damage.base (exists system.damage.twoHanded) (exists system.hitBonus))}}
  <div class="teriock-sheet-bar">
    {{#if (or system.damage.base system.damage.twoHanded)}}
      {{formUpdater
        document
        abbreviation=(localize "TERIOCK.SYSTEMS.Armament.FIELDS.damage.abbreviation")
        action="updateArmamentDamage"
        data=damage.data
        icon=TERIOCK.DISPLAY.icons.manifest.ui.damage
        info="core:base-damage"
        label=(localize "TERIOCK.SYSTEMS.Armament.FIELDS.damage.label")
        source=damage.source
      }}
    {{/if}}
    {{#if (exists system.hitBonus)}}
      {{formUpdater
        document
        abbreviation=(localize "TERIOCK.SYSTEMS.Attack.FIELDS.hitBonus.abbreviation")
        icon=TERIOCK.DISPLAY.icons.manifest.armament.hitBonus
        path="system.hitBonus"
        placeholder="0"
      }}
    {{/if}}
    {{#if (or system.damage.base system.damage.twoHanded)}}
      {{formUpdater
        document
        abbreviation=(localize "TERIOCK.SYSTEMS.Attack.FIELDS.attackPenalty.abbreviation")
        icon=TERIOCK.DISPLAY.icons.manifest.armament.ap
        info="core:multiple-attacks"
        path="system.attackPenalty"
        placeholder="0"
      }}
    {{/if}}
  </div>
{{/if}}
{{#if (or (exists system.av.raw) (exists system.bv.raw))}}
  <div class="teriock-sheet-bar">
    {{#if (exists system.av.raw)}}
      {{formUpdater
        document
        abbreviation=(localize "TERIOCK.SYSTEMS.Armament.FIELDS.av.abbreviation")
        icon=TERIOCK.DISPLAY.icons.manifest.armament.av
        info="core:armor-class"
        path="system.av.raw"
      }}
    {{/if}}
    {{#if (exists system.bv.raw)}}
      {{formUpdater
        document
        abbreviation=(localize "TERIOCK.SYSTEMS.Armament.FIELDS.bv.abbreviation")
        icon=TERIOCK.DISPLAY.icons.manifest.armament.bv
        info="core:block-interaction"
        path="system.bv.raw"
      }}
    {{/if}}
  </div>
{{/if}}
