<div
  class='
    teriock-sheet-header
    {{#if (and (eq item.type "equipment") system.shattered)}}
      shattered
    {{/if}}
  '
>
  <div
    class="teriock-sheet-profile-img"
    {{#if (exists system.color)}}
      style="outline-color:{{{ system.color.css }}}"
    {{/if}}
  >
    <img
      class="profile-img"
      alt=""
      data-action="editImage"
      data-edit="{{ imgPath }}"
      data-disable="false"
      src="{{ img }}"
      title="{{ name }}"
    />
  </div>
  <div class="teriock-sheet-title affix">
    {{#if (exists system.fullName)}}
      {{formInput
        fields.name
        value=system.fullName
        classes="tfont unselected"
        placeholder=(localize "DOCUMENT.FIELDS.name.label")
        name="fullName"
        editable=false
      }}
    {{/if}}
    {{formInput
      fields.name
      value=source.name
      classes=(ifThen (exists system.fullName) "tfont selected" "tfont")
      placeholder=(localize "DOCUMENT.FIELDS.name.label")
    }}
  </div>
  {{#if system.competence}}
    <div
      class="
        teriock-sheet-competence
        affix-icon
        updatable
        competence
        {{formClasses document path="system.competence.raw"}}
      "
      data-action="updatePaths"
      data-icon="{{ TERIOCK.display.icons.manifest.competence.proficient }}"
      data-paths="system.competence.raw"
      data-tooltip="{{ system.competence.description }}"
    >
      <i class="unselected mic fa-light {{ system.competence.icon }}"></i>
      <i class='selected mic fa-light {{path TERIOCK.config.competence.levels source.system.competence.raw "icon"}}'
      ></i>
    </div>
  {{/if}}
</div>
