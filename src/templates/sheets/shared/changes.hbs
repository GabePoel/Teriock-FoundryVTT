{{!--
  Reusable changes template. This is generalized so that it works for the default `ActiveEffect` changes as well as
  custom arrays that have the same basic format.

  Parameters (and default values for normal `ActiveEffect` changes):
  - changesPath: "system.changes"
  - changesData: (path document.system "changes")
  - fieldDefs: (path fields "changes.element.fields")
  - additionalAttrs: Not actually needed for default changes. This is for abilities mainly.
--}}

<ol class="change-config-container" data-changes>
  {{#each changesData as |change i|}}
    {{#with ../fieldDefs as |changeFields|}}
      <li class="change-container">
        <div class="change-entry">
          {{formIcon
            changeFields.key
            name=(concat ../../changesPath "." i ".key")
            value=change.key
            disabled=(not @root/editable)
            icon=@root/TERIOCK.DISPLAY.icons.manifest.change.key
            id=(concat @root/rootId ../../changesPath "." i ".key")
          }}
          {{formIcon
            changeFields.value
            name=(concat ../../changesPath "." i ".value")
            value=change.value
            changeType=change.type
            icon=@root/TERIOCK.DISPLAY.icons.manifest.change.value
            disabled=(not @root/editable)
            id=(concat @root/rootId ../../changesPath "." i ".value")
          }}
        </div>
        <div class="change-config">
          <div class="change-activation">
            {{formIcon
              changeFields.priority
              name=(concat ../../changesPath "." i ".priority")
              value=change.priority
              icon=@root/TERIOCK.DISPLAY.icons.manifest.change.priority
              placeholder=change.defaultPriority
              disabled=(not @root/editable)
              id=(concat @root/rootId ../../changesPath "." i ".priority")
            }}
            {{#if changeFields.phase}}
              {{formIcon
                changeFields.phase
                name=(concat ../../changesPath "." i ".phase")
                value=change.phase
                icon=@root/TERIOCK.DISPLAY.icons.manifest.change.phase
                disabled=(not @root/editable)
                id=(concat @root/rootId ../../changesPath "." i ".phase")
                dataset=(object tooltip=(localize (concat "TERIOCK.CHANGES.Phase." change.phase ".hint")))
              }}
            {{/if}}
          </div>
          <div class="change-assignment">
            {{formIcon
              changeFields.type
              name=(concat ../../changesPath "." i ".type")
              value=change.type
              icon=@root/TERIOCK.DISPLAY.icons.manifest.change.type
              disabled=(not @root/editable)
              id=(concat @root/rootId ../../changesPath "." i ".type")
            }}
            {{formIcon
              changeFields.target
              name=(concat ../../changesPath "." i ".target")
              value=change.target
              icon=@root/TERIOCK.DISPLAY.icons.manifest.change.target
              disabled=(not @root/editable)
              id=(concat @root/rootId ../../changesPath "." i ".target")
            }}
          </div>
        </div>
        <input
          type="hidden"
          name='{{concat ../../changesPath "." i ".applyIfSuppressed"}}'
          value="{{ change.applyIfSuppressed }}"
        />
        <div class="change-controls">
          {{!-- prettier-ignore --}}
          <button
            class="change-delete"
            type="button"
            id='{{concat @root/rootId ../../changesPath "." i ".delete"}}'
            data-action="deleteParentChange"
            data-tooltip='{{localize "TERIOCK.CHANGES.Actions.deleteChange"}}'
            data-index="{{ i }}"
            data-path="{{ ../../changesPath }}"
            data-value-path="{{ ../../valuePath }}"
            {{#each ../additionalAttrs as |value key|}}data-{{ key }}="{{ value }}"
            {{/each}}
          >
            {{makeIcon @root/TERIOCK.DISPLAY.icons.manifest.ui.delete "button"}}
          </button>
          {{#if (and changeFields.applyIfSuppressed (eq change.target "Item"))}}
            <button
              id='{{concat @root/rootId ../../changesPath "." i ".applyIfSuppressed"}}'
              class="change-suppress"
              type="button"
              aria-pressed='{{ifThen change.applyIfSuppressed "true" "false"}}'
              data-action="toggleParentChangeSuppress"
              data-tooltip='{{localize (concat "TERIOCK.SCHEMA.Change.applyIfSuppressed." (ifThen change.applyIfSuppressed "true" "false"))}}'
              data-index="{{ i }}"
              data-path="{{ ../../changesPath }}"
            >
              {{makeIcon (ifThen change.applyIfSuppressed
                  @root/TERIOCK.DISPLAY.icons.manifest.change.applyIfSuppressed
                  @root/TERIOCK.DISPLAY.icons.manifest.change.skipIfSuppressed) "button"}}
            </button>
          {{/if}}
        </div>
      </li>
    {{/with}}
  {{/each}}
  {{!-- prettier-ignore --}}
  <button
    class="add-change-button"
    type="button"
    id='{{concat @root/rootId changesPath ".add"}}'
    data-action="addParentChange"
    data-path="{{ changesPath }}"
    data-value-path="{{ valuePath }}"
    {{#each additionalAttrs as |value key|}}data-{{ key }}="{{ value }}"
    {{/each}}
  >
    {{makeIcon TERIOCK.DISPLAY.icons.manifest.ui.add "button"}}
    {{localize "TERIOCK.CHANGES.Actions.addChange"}}
  </button>
</ol>
