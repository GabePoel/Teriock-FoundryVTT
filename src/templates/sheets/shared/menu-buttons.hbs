{{#if canHaveMechanics}}
  <button
    id="{{concat @root/appId 'toggle-sheet-mechanics-button'}}"
    class="teriock-sheet-icon teriock-sheet-mechanics-toggle teriock-sheet-menu-mechanics-container"
    type="button"
    data-tooltip="TERIOCK.SHEETS.Common.NAVIGATION.enterMechanicsTab"
    data-action="toggleMechanics"
    data-disable="false"
  >
    <span>{{makeIcon TERIOCK.display.icons.manifest.pseudoDocument.mechanic "solid"}}</span>
  </button>
{{/if}}
<button
  id="{{concat @root/appId 'toggle-sheet-menu-button'}}"
  class="teriock-sheet-icon teriock-sheet-menu-toggle"
  type="button"
  data-tooltip="TERIOCK.SHEETS.Common.NAVIGATION.toggleMenu"
  data-action="toggleCollapse"
  data-collapsible-target="menu"
  data-disable="false"
>
  <span>{{makeIcon TERIOCK.display.icons.manifest.ui.menuOpen "solid"}}</span>
</button>
