<div
  class="
    thover
    die-box
    {{#if spent}}
      spent
    {{/if}}
  "
  data-action="rollStatDie"
  data-id="{{ id }}"
  data-stat="{{ stat }}"
  data-tooltip-direction="DOWN"
  data-tooltip-html="<div class='die-tooltip'><div>{{ polyhedral }} {{ name }}</div>{{#if sourceName}}<div>({{ sourceName }})</div>{{/if}}</div>"
>
  <i
    class='
      {{#if spent}}
        {{makeIconClass icon "regular"}}
        fa-faint
      {{else}}
        {{makeIconClass icon "solid"}}
      {{/if}}
    '
  ></i>
</div>
