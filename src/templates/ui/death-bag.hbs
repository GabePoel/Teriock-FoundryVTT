<div class="teriock death-bag-pull dice-roll">
  {{#each pulledStones as |number color|}}
    {{#if (gt number 0)}}
      <div class="death-bag-stones-container">
        <header class="message-header">
          <span class="flavor-text">
            {{localize
              "TERIOCK.TERMS.Stones.ofColor"
              color=(localize (concat "TERIOCK.TERMS.StoneColor." color))
            }}
          </span>
        </header>
        <div class="death-bag-stones dice-formula">
          {{#repeat number}}
            <div class="death-bag-stone" data-tooltip='{{path @root/TERIOCK.config.deathBag.stones color "label"}}'>
              <img
                src="systems/teriock/src/assets/thumbnails/stone/{{ color }}.webp"
                alt='{{path @root/TERIOCK.config.deathBag.stones color "label"}}'
              />
            </div>
          {{/repeat}}
        </div>
        <div class="dice-result">
          <h4 class="dice-total message-result">{{ number }}</h4>
        </div>
      </div>
    {{/if}}
  {{/each}}
</div>
