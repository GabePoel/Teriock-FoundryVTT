<nav class="teriock-vertical-tabs tabs">
  {{#each tabs as |tab|}}
    <div
      {{#if (or tab.label tab.tooltip)}}
        data-tooltip="{{#if tab.tooltip}}{{ tab.tooltip }}{{else}}{{ tab.label }}{{/if}}"
      {{/if}}
    >
      {{!-- TODO: Should these be <a> elements like the default tab-navigation.hbs? --}}
      {{!-- prettier-ignore --}}
      <button
        id='{{concat @root/appId "-" tab.group "-" tab.id}}'
        class="teriock-vertical-tab {{ tab.cssClass }}"
        type="button"
        data-action="tab"
        data-disable="false"
        data-group="{{ tab.group }}"
        data-tab="{{ tab.id }}"
      >
        {{#if tab.icon}}<i class="{{tab.icon}}" inert></i>{{/if}}
      </button>
    </div>
  {{/each}}
</nav>
