<div
  class="teriock-mechanic-container collapsible"
  data-collapsible-id="mechanic-{{ mechanic.documentName }}-{{ mechanic.id }}"
>
  <header class="teriock-mechanic-header draggable" data-action="toggleCollapse" data-uuid="{{ mechanic.uuid }}">
    <div class="teriock-mechanic-header-name">{{localize mechanic.label}}</div>
    <div class="teriock-mechanic-header-buttons" data-collapsible-ignore>
      {{#each mechanic.toggles as |toggles|}}
        <div class="teriock-mechanic-header-button-group">
          {{#each toggles as |toggle|}}
            {{!-- prettier-ignore --}}
            <button
              data-action="setToggle"
              data-path="{{ ../../mechanic.localPath }}.disabledToggles"
              data-term="{{ toggle.id }}"
              data-tooltip='{{ifThen toggle.active toggle.on toggle.off}}'
              id="{{ ../../mechanic.uuid }}.{{ toggle.id }}"
              type="button"
            >
              {{makeIcon
                toggle.icon
                (ifThen toggle.active "solid" "light")
              }}
            </button>
          {{/each}}
        </div>
      {{/each}}
      <div class="teriock-mechanic-header-button-group">
        {{!-- prettier-ignore --}}
        <button
          data-action="editActiveQualifier"
          data-id="{{ mechanic.id }}"
          data-tooltip="TERIOCK.MECHANICS.Base.FIELDS.activeQualifier.edit"
          data-uuid="{{ mechanic.uuid }}"
          type="button"
        >
          {{makeIcon
            @root/TERIOCK.DISPLAY.icons.manifest.ui.qualifier
            (ifThen mechanic.hasActiveQualifierSet "solid" "light")
          }}
        </button>
        {{!-- prettier-ignore --}}
        <button
          data-action="copyMechanicUuid"
          data-disable="false"
          data-id="{{ mechanic.id }}"
          data-tooltip="APPLICATION.ACTIONS.CopyUuid"
          data-uuid="{{ mechanic.uuid }}"
          type="button"
        >
          {{makeIcon
            @root/TERIOCK.DISPLAY.icons.manifest.ui.copyUuid
            "button"
          }}
        </button>
      </div>
      <div class="teriock-mechanic-header-button-group">
        {{!-- prettier-ignore --}}
        <button
          data-action="deleteMechanic"
          data-id="{{ mechanic.id }}"
          data-tooltip="COMMON.Delete"
          data-uuid="{{ mechanic.uuid }}"
          type="button"
        >
          {{makeIcon
            @root/TERIOCK.DISPLAY.icons.manifest.ui.delete
            "button"
          }}
        </button>
      </div>
    </div>
  </header>
  <div class="teriock-mechanic-collapse-target">
    <div class="teriock-mechanic-spacer">
      <div class="teriock-mechanic-content teriock-form-container">
        {{> "teriock/ui/tips"
          tips=tips
        }}
        {{{ formEditor }}}
      </div>
    </div>
  </div>
</div>
