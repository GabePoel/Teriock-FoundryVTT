<section class="flexcol">
  <h4 class="divider">{{localize label}}</h4>
  <div class="tgrid g2">
    {{#each buttons as |button|}}
      <button
        type="{{ button.type }}"
        data-action="{{ button.action }}"
        {{#each button.data}}
          data-{{ @key }}="{{ this }}"
        {{/each}}
      >
        {{#if button.icon}}
          <i class="{{ button.icon }}" inert></i>
        {{/if}}
        {{#if button.label}}
          <span>
            {{localize button.label}}
          </span>
        {{/if}}
      </button>
    {{/each}}
  </div>
</section>
