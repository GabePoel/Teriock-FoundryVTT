<li
  class="combatant {{ css }}"
  data-action="activateCombatant"
  data-combatant-id="{{ id }}"
  data-uuid="{{ uuid }}"
  data-tooltip-uuid="{{ uuid }}"
  data-tooltip-direction="LEFT"
>
  <div class="token-image" style="outline-color:{{ color.css }}">
    <img src="{{ img }}" alt="{{ name }}" loading="lazy" />
  </div>
  <div class="token-name">
    <strong class="name">
      {{#if icon}}
        <i class="{{ icon.css }}" data-tooltip="{{ icon.tooltip }}" data-tooltip-class="" data-tooltip-direction=""></i>
      {{/if}}
      {{ name }}
    </strong>
    <div class="combatant-controls">
      {{#if @root.user.isGM}}
        <button
          class="
            inline-control
            combatant-control
            icon
            fa-solid
            fa-eye-slash
            {{#if hidden}}
              active
            {{/if}}
          "
          type="button"
          aria-label="{{localize (ifThen hidden 'COMBATANT.Show' 'COMBATANT.Hide')}}"
          data-action="toggleHidden"
          data-tooltip
          data-tooltip-class=""
          data-tooltip-direction=""
        ></button>
        <button
          class="
            inline-control
            combatant-control
            icon
            fa-solid
            fa-skull
            {{#if isDefeated}}
              active
            {{/if}}
          "
          type="button"
          aria-label="{{localize (ifThen isDefeated 'COMBATANT.UnmarkDefeated' 'COMBATANT.MarkDefeated')}}"
          data-action="toggleDefeated"
          data-tooltip
          data-tooltip-class=""
          data-tooltip-direction=""
        ></button>
      {{/if}}
      {{#if canPing}}
        <button
          class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
          type="button"
          aria-label="{{localize 'COMBATANT.Ping'}}"
          data-action="pingCombatant"
          data-tooltip
          data-tooltip-class=""
          data-tooltip-direction=""
        ></button>
      {{/if}}
      {{#unless @root.user.isGM}}
        <button
          class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
          type="button"
          aria-label="{{localize 'COMBATANT.PanTo'}}"
          data-action="panToCombatant"
          data-tooltip
          data-tooltip-class=""
          data-tooltip-direction=""
        ></button>
      {{/unless}}
      {{#if reaction}}
        <button
          class="inline-control combatant-control icon {{ reaction.css }}"
          type="button"
          data-action="toggleReaction"
          data-tooltip="TERIOCK.SHEETS.Actor.SIDEBAR.ReactionBox.tooltip"
          data-tooltip-class=""
          data-tooltip-direction=""
          {{disabled reaction.disabled}}
        ></button>
      {{/if}}
      <div
        class="token-effects"
        data-tooltip-html="{{ effects.tooltip }}"
        data-tooltip-class=""
        data-tooltip-direction=""
      >
        {{#each effects.icons}}
          <img class="token-effect" src="{{ img }}" alt="{{ name }}" />
        {{/each}}
      </div>
    </div>
  </div>
  {{#if resource includeZero=true}}
    <div class="token-resource">
      <span class="resource">{{ resource }}</span>
    </div>
  {{/if}}
  {{> "teriock/sidebar/initiative"}}
</li>
