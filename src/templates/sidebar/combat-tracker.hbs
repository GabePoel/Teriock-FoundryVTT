<ol class="combat-tracker plain">
  {{#each turns}}
    {{#if group}}
      <li
        class="combatant-group collapsible {{ css }}"
        data-collapsible-id="group-{{ group.id }}"
        data-group-id="{{ group.id }}"
      >
        <div class="combatant-group-header combatant-group-row {{ css }}" data-action="activateCombatant">
          <div class="token-image">
            <img src="{{ group.img }}" alt="{{ group.name }}" loading="lazy" />
          </div>
          <div class="token-name">
            <strong class="name">{{ group.name }}</strong>
            <div class="combatant-controls">
              {{#if @root.user.isGM}}
                <button
                  class="
                    inline-control
                    combatant-control
                    icon
                    fa-solid
                    fa-eye-slash
                    {{#if group.hidden}}
                      active
                    {{/if}}
                  "
                  type="button"
                  aria-label="{{localize (ifThen group.hidden 'COMBATANT.Show' 'COMBATANT.Hide')}}"
                  data-action="toggleHidden"
                  data-tooltip
                ></button>
                <button
                  class="
                    inline-control
                    combatant-control
                    icon
                    fa-solid
                    fa-skull
                    {{#if group.defeated}}
                      active
                    {{/if}}
                  "
                  type="button"
                  aria-label="{{localize (ifThen group.defeated 'COMBATANT.UnmarkDefeated' 'COMBATANT.MarkDefeated')}}"
                  data-action="toggleDefeated"
                  data-tooltip
                ></button>
              {{else}}
                <button
                  class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                  type="button"
                  aria-label="{{localize 'TERIOCK.COMBAT.Group.panTo'}}"
                  data-action="panToCombatant"
                  data-tooltip
                ></button>
              {{/if}}
            </div>
          </div>
          {{> "teriock/sidebar/initiative"
            group
          }}
        </div>
        <div class="combatant-group-members-container">
          <ol class="combatant-group-members plain">
            {{#each members}}
              {{> "teriock/sidebar/combatant"}}
            {{/each}}
          </ol>
        </div>
        <div
          id="{{ @root/appId }}-{{ group.id }}-toggle"
          class="combatant-group-toggle"
          aria-label="{{localize 'TERIOCK.COMBAT.Group.toggle'}}"
          data-action="toggleCollapse"
        >
          <i class="fa-solid fa-chevron-up"></i>
        </div>
      </li>
    {{else}}
      {{> "teriock/sidebar/combatant"}}
    {{/if}}
  {{/each}}
</ol>
