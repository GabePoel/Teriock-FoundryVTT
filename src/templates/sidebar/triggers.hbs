{{#each groups}}
<section class="flexcol">
    <h4 class="divider">{{localize label}}</h4>
    {{#each triggers}}
    <button type="button" data-action="fire" data-group="{{../group}}" data-trigger="{{trigger}}">
        <i class="{{icon}}" inert></i> {{label}}
    </button>
    {{/each}}
</section>
{{/each}}
